# API URL - Use relative path for proxy (Astro forwards /api/* to backend)
PUBLIC_API_URL=/api/v1

# POS URL
PUBLIC_POS_URL=http://192.168.0.10:1420

# PayPal
PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PUBLIC_PAYPAL_SANDBOX=true

# Whop (proveedor primario) — plan_... del plan mensual de $12.99
PUBLIC_WHOP_PLAN_ID=
