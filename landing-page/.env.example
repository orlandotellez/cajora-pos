# API del backend (el mismo endpoint que usa el frontend del POS)
PUBLIC_API_URL="http://localhost:3000/api/v1"

# Client ID público de PayPal (el secret queda solo en el backend).
# Sandbox: PAYPAL_SANDBOX=true en backend-fastify/.env
PUBLIC_PAYPAL_CLIENT_ID=""
PUBLIC_PAYPAL_SANDBOX=true

# URL del POS (a donde se redirige al cliente tras el registro/pago)
PUBLIC_POS_URL="http://localhost:5173"
