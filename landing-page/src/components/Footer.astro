---
const base = import.meta.env.BASE_URL;

const CONFIG_URL =
  import.meta.env.PUBLIC_CONFIG_API_URL ??
  'https://pub-17156739f1d5412cb62a579bb0ccbc35.r2.dev/config-api.json';

let version = 'v2.1.2';
try {
  const res = await fetch(CONFIG_URL, { signal: AbortSignal.timeout(5000) });
  if (res.ok) {
    const cfg = await res.json();
    if (cfg.app_version) version = `v${cfg.app_version}`;
  }
} catch {}
---

<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__row">
      <!-- Logo & Brand -->
      <div class="site-footer__brand">
        <span class="site-footer__mark">
          <svg class="site-footer__mark-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
            <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
            <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
            <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            <path d="M8 7v10"></path>
            <path d="M12 7v10"></path>
            <path d="M17 7v10"></path>
          </svg>
        </span>
        <span class="site-footer__name">Cajora POS</span>
      </div>

      <!-- Center links -->
      <nav class="site-footer__nav" aria-label="Legal">
        <a class="site-footer__link" href={base + 'privacidad'}>Política de Privacidad</a>
        <a class="site-footer__link" href={base + 'terminos'}>Términos y Condiciones</a>
        <a class="site-footer__link" href={base + 'descargar'}>Descargas</a>
        <a class="site-footer__link" href="mailto:payments@cajorapos.com">Contacto</a>

        <!-- Social icons -->
        <div class="site-footer__social">
          <a aria-label="Facebook" class="site-footer__social-link" href="https://www.facebook.com/profile.php?id=61593931509492" target="_blank" rel="noopener noreferrer">
            <svg class="site-footer__social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path></svg>
          </a>
          <a aria-label="GitHub" class="site-footer__social-link" href="https://github.com/orlandotellez/cajora-pos" target="_blank" rel="noopener noreferrer">
            <svg class="site-footer__social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z"></path></svg>
          </a>
        </div>
      </nav>

      <!-- Version -->
      <div class="site-footer__meta">© 2026 CajoraPOS. {version}</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .site-footer__container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-footer__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: center;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--text);
    border-radius: 0.375rem;
    font-weight: 700;
  }

  .site-footer__mark-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .site-footer__name {
    color: var(--text);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }

  .site-footer__link {
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .site-footer__link:hover {
    color: var(--text);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .site-footer__social-link {
    color: var(--text-muted);
    padding: 0.25rem;
    transition: color 150ms ease;
  }
  .site-footer__social-link:hover {
    color: var(--text);
  }

  .site-footer__social-icon {
    width: 1rem;
    height: 1rem;
  }

  .site-footer__meta {
    color: var(--text-muted);
    opacity: 0.7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
  }

  @media (min-width: 768px) {
    .site-footer__row {
      flex-direction: row;
      text-align: left;
    }
  }
</style>
