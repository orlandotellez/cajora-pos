---
const base = import.meta.env.BASE_URL;

const CONFIG_URL =
  import.meta.env.PUBLIC_CONFIG_API_URL ??
  'https://pub-17156739f1d5412cb62a579bb0ccbc35.r2.dev/config-api.json';

let version = 'v2.1.2';
try {
  const res = await fetch(CONFIG_URL, { signal: AbortSignal.timeout(5000) });
  if (res.ok) {
    const cfg = await res.json();
    if (cfg.app_version) version = `v${cfg.app_version}`;
  }
} catch {}
---

<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__row">
      <!-- Logo & Brand -->
      <div class="site-footer__brand">
        <span class="site-footer__mark">
          <svg class="site-footer__mark-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
            <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
            <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
            <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            <path d="M8 7v10"></path>
            <path d="M12 7v10"></path>
            <path d="M17 7v10"></path>
          </svg>
        </span>
        <span class="site-footer__name">Cajora POS</span>
      </div>

      <!-- Center links -->
      <nav class="site-footer__nav" aria-label="Legal">
        <a class="site-footer__link" href={base + 'privacidad'}>Política de Privacidad</a>
        <a class="site-footer__link" href={base + 'terminos'}>Términos y Condiciones</a>
        <a class="site-footer__link" href={base + 'descargar'}>Descargas</a>
        <a class="site-footer__link" href="mailto:payments@cajorapos.com">Contacto</a>
        <a class="site-footer__link site-footer__link--external" href="https://github.com/orlandotellez/cajora-pos" rel="noopener noreferrer" target="_blank">
          GitHub
          <svg class="site-footer__link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        </a>

        <!-- Social icons -->
        <div class="site-footer__social">
          <a aria-label="Facebook" class="site-footer__social-link" href="https://www.facebook.com/profile.php?id=61593931509492" target="_blank">
            <svg class="site-footer__social-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path></svg>
          </a>
        </div>
      </nav>

      <!-- Version -->
      <div class="site-footer__meta">© 2026 CajoraPOS. {version}</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .site-footer__container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-footer__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: center;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--text);
    border-radius: 0.375rem;
    font-weight: 700;
  }

  .site-footer__mark-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .site-footer__name {
    color: var(--text);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }

  .site-footer__link {
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .site-footer__link:hover {
    color: var(--text);
  }

  .site-footer__link--external {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .site-footer__link-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .site-footer__social-link {
    color: var(--text-muted);
    padding: 0.25rem;
    transition: color 150ms ease;
  }
  .site-footer__social-link:hover {
    color: var(--text);
  }

  .site-footer__social-icon {
    width: 1rem;
    height: 1rem;
  }

  .site-footer__meta {
    color: var(--text-muted);
    opacity: 0.7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
  }

  @media (min-width: 768px) {
    .site-footer__row {
      flex-direction: row;
      text-align: left;
    }
  }
</style>
