---
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Inicio', href: base },
  { label: 'Características', href: base + '#features' },
  { label: 'Precios', href: base + '#pricing' },
  { label: 'FAQ', href: base + '#faq' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a href={import.meta.env.BASE_URL} class="brand" aria-label="CajoraPOS inicio">
      <span class="brand__mark"><Logo size={28} /></span>
      <span class="brand__name">CajoraPOS</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul class="site-nav__list">
        {links.map((link) => (
          <li><a href={link.href} class="site-nav__link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="icon-btn"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Cambiar a tema claro"
        data-theme-toggle
      >
        <span class="icon-btn__sun"><Icon name="sun" size={20} /></span>
        <span class="icon-btn__moon"><Icon name="moon" size={20} /></span>
      </button>
      <a href={import.meta.env.BASE_URL + 'login'} class="btn-secondary site-header__cta" data-auth-cta="secondary">
        Iniciar sesión
      </a>
      <a href={import.meta.env.BASE_URL + '#pricing'} class="btn-primary site-header__cta" data-auth-cta="primary">
        Registrar tienda
      </a>
      <button
        class="menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="menu-btn__bar"></span>
        <span class="menu-btn__bar"></span>
        <span class="menu-btn__bar"></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil: se despliega de arriba hacia abajo -->
  <nav class="site-menu" id="site-menu" data-menu hidden aria-label="Menú móvil">
    <ul class="site-menu__list">
      {links.map((link) => (
        <li>
          <a href={link.href} class="site-menu__link" data-menu-close>{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="site-menu__actions">
      <a
        href={import.meta.env.BASE_URL + 'login'}
        class="btn-secondary site-menu__cta"
        data-auth-cta="secondary"
        data-menu-close
      >
        Iniciar sesión
      </a>
      <a
        href={import.meta.env.BASE_URL + '#pricing'}
        class="btn-primary site-menu__cta"
        data-auth-cta="primary"
        data-menu-close
      >
        Registrar tienda
      </a>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const lightMeta = '#F6F8FB';
  const darkMeta = '#10151E';

  const syncToggle = () => {
    const theme = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    toggle?.setAttribute(
      'aria-label',
      theme === 'light' ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro'
    );
    toggle?.setAttribute('aria-checked', String(theme === 'light'));
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'light' ? lightMeta : darkMeta);
  };

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* almacenamiento no disponible */
    }
    syncToggle();
  });

  syncToggle();

  // -------- Menú móvil (hamburguesa) --------
  const menu = document.querySelector('[data-menu]');
  const menuToggle = document.querySelector('[data-menu-toggle]');

  const setMenuOpen = (open) => {
    if (!menu || !menuToggle) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (open) {
      menu.hidden = false;
      menu.removeAttribute('data-closing');
    } else {
      // Animar el cierre (menú visible → oculto) sin quitar el nodo del flujo
      menu.setAttribute('data-closing', '');
      menu.addEventListener(
        'animationend',
        () => {
          if (menu.hasAttribute('data-closing')) {
            menu.hidden = true;
            menu.removeAttribute('data-closing');
          }
        },
        { once: true }
      );
    }
  };

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(menu?.hidden === true);
  });

  // Cerrar al tocar un enlace del menú
  document.querySelectorAll('[data-menu-close]').forEach((el) => {
    el.addEventListener('click', () => setMenuOpen(false));
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  // Cerrar si la ventana crece a tamaño desktop (el menú es solo móvil)
  const mqDesktop = window.matchMedia('(min-width: 769px)');
  mqDesktop.addEventListener('change', (e) => {
    if (e.matches) setMenuOpen(false);
  });

  const baseUrl = import.meta.env.BASE_URL;
  const navLinks = [...document.querySelectorAll('.site-nav__link')];
  const sections = navLinks
    .map((link) => {
      const href = link.getAttribute('href') ?? '';
      const hashIndex = href.indexOf('#');
      return hashIndex === -1 ? null : document.querySelector(href.slice(hashIndex));
    })
    .filter(Boolean);

  const setActive = (id) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const isActive = id === '' ? href === baseUrl : href.endsWith(`#${id}`);
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const onScroll = () => {
    const marker = 90;
    let current = '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= marker) {
        current = section.id;
      } else {
        break;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Alto a propósito: los iframes de terceros (botones PayPal) se pintan
       en capas propias y con z-index bajos pueden quedar por encima. */
    z-index: 1000;
    background: var(--glass);
    border-bottom: 1px solid var(--border);
    transition: background-color 250ms ease, border-color 250ms ease;
  }

  .site-header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__mark {
    display: inline-flex;
    color: var(--text);
  }

  .site-nav {
    justify-self: center;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .site-nav__link:hover {
    color: var(--text);
  }

  .site-nav__link.is-active {
    color: var(--text);
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cta {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .icon-btn:hover {
    background: var(--surface);
    color: var(--text);
  }

  /* El icono muestra el tema al que se puede cambiar */
  .icon-btn__sun {
    display: inline-flex;
  }

  .icon-btn__moon {
    display: none;
  }

  html[data-theme='light'] .icon-btn__sun {
    display: none;
  }

  html[data-theme='light'] .icon-btn__moon {
    display: inline-flex;
  }

  /* -------- Botón hamburguesa (solo móvil) -------- */
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .menu-btn:hover {
    background: var(--surface);
    color: var(--text);
  }

  .menu-btn__bar {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 200ms ease, opacity 150ms ease;
  }

  .menu-btn[aria-expanded='true'] .menu-btn__bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-btn__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-btn[aria-expanded='true'] .menu-btn__bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* -------- Menú móvil (desplegable de arriba hacia abajo) -------- */
  .site-menu[hidden] {
    display: none;
  }

  .site-menu {
    display: none;
  }

  .site-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-menu__link {
    display: block;
    padding: 0.875rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: color 150ms ease;
  }

  .site-menu__link:hover {
    color: var(--text);
  }

  .site-menu__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    margin-top: 1rem;
  }

  .site-menu__cta {
    width: 100%;
    padding: 0.75rem 1rem;
  }

  @media (max-width: 768px) {
    .menu-btn {
      display: inline-flex;
    }

    /* En el header solo queda "Registrar tienda" + hamburguesa */
    .site-header__cta[data-auth-cta='secondary'] {
      display: none;
    }

    .site-menu {
      display: block;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      z-index: 49;
      background: var(--glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem 1.5rem;
      animation: menu-slide-down 220ms ease;
    }

    .site-menu[data-closing] {
      animation: menu-slide-up 180ms ease forwards;
    }
  }

  @keyframes menu-slide-down {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menu-slide-up {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }

    /* En móvil el header queda de 2 columnas: marca | acciones a la derecha */
    .site-header__row {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }

    .site-header__actions {
      justify-self: end;
    }
  }

  @media (max-width: 480px) {
    .site-header__actions {
      gap: 0.5rem;
    }

    .site-header__cta {
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }
  }
</style>
