---
import { SquareArrowOutUpRight } from 'lucide-astro';

interface Props {
  desktop?: string;
  desktopAlt?: string;
  laptop?: string;
  mobile?: string;
  mobileAlt?: string;
  url?: string;
  urlHref?: string;
  halo?: boolean;
}

const base = import.meta.env.BASE_URL;

const {
  desktop = base + 'desktop.webp',
  desktopAlt = '',
  laptop = desktop,
  mobile = base + 'mobile.webp',
  mobileAlt = '',
  url = 'app.cajorapos.com',
  urlHref = 'https://app.cajorapos.com/pos',
  halo = true,
} = Astro.props;
---

<div class="device-cluster">
  {halo && <div class="mockup__halo" aria-hidden="true"></div>}

  <div class="mockup-frame">
    <div class="mockup-bar">
      <a
        class="mockup-bar__url"
        href={urlHref}
        target="_blank"
        rel="noopener"
        aria-label="Abrir CajoraPOS en nueva pestaña"
      >
        <SquareArrowOutUpRight class="mockup-bar__icon" aria-hidden="true" />
        {url}
      </a>
    </div>
    <div class="mockup-screen">
      <img
        class="mockup__img"
        src={desktop}
        alt={desktopAlt}
        width="1854"
        height="1007"
      />
      <div class="mockup-screen__sheen" aria-hidden="true"></div>
      <div class="mockup-screen__base" aria-hidden="true"></div>
    </div>
  </div>

  <div class="mockup-base"></div>
  <div class="mockup-foot"></div>

  <div class="laptop" aria-hidden="true">
    <div class="laptop__screen">
      <img
        class="laptop__img"
        src={laptop}
        alt=""
        loading="lazy"
        width="1854"
        height="1007"
      />
    </div>
    <div class="laptop__base"></div>
  </div>

  <div class="mockup-phone" aria-hidden="true">
    <div class="mockup-phone__frame">
      <div class="mockup-phone__status">
        <span>9:41</span>
        <span class="mockup-phone__notch"></span>
      </div>
      <img
        class="mockup-phone__img"
        src={mobile}
        alt={mobileAlt}
        loading="lazy"
        width="522"
        height="1007"
      />
      <div class="mockup-phone__nav" aria-hidden="true">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="8"></circle>
        </svg>
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="6" y="6" width="12" height="12" rx="2"></rect>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .device-cluster {
    position: relative;
    width: 100%;
  }

  /* ---------- Monitor ---------- */
  .mockup__halo {
    position: absolute;
    inset: -1rem;
    z-index: -1;
    border-radius: 7px;
    background: linear-gradient(to right, rgba(63, 63, 70, 0.15), rgba(255, 255, 255, 0.05), rgba(63, 63, 70, 0.15));
    filter: blur(24px);
    opacity: 0.7;
    pointer-events: none;
  }

  .mockup-frame {
    padding: 0.5rem 0.625rem;
    background: #16161a;
    border: 1px solid rgba(63, 63, 70, 0.8);
    border-radius: 7px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9);
  }

  .mockup-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 1rem;
    background: rgba(24, 24, 27, 0.95);
    border-bottom: 1px solid #27272a;
    border-radius: 7px 7px 0 0;
  }

  .mockup-bar__url {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    color: #d4d4d8;
    background: rgba(4, 6, 9, 0.8);
    border: 1px solid rgba(39, 39, 42, 0.8);
    border-radius: 7px;
    padding: 0.2rem 0.75rem;
    box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .mockup-bar__url:hover {
    color: #ffffff;
    border-color: rgba(82, 82, 91, 0.8);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mockup-bar__icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 150ms ease;
  }
  .mockup-bar__url:hover .mockup-bar__icon {
    opacity: 1;
  }

  .mockup-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0 0 7px 7px;
    overflow: hidden;
    background: #000000;
    border-left: 1px solid #27272a;
    border-right: 1px solid #27272a;
    border-bottom: 1px solid #27272a;
  }

  .mockup__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    -webkit-user-select: none;
    user-select: none;
    display: block;
  }

  .mockup-screen__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top right, transparent, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.06));
    pointer-events: none;
  }

  .mockup-screen__base {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0.75rem;
    background: #000000;
    pointer-events: none;
    z-index: 10;
  }

  .mockup-base {
    width: 8rem;
    height: 1.25rem;
    margin: 0 auto;
    border-radius: 0 0 7px 7px;
    border-left: 1px solid #52525b;
    border-right: 1px solid #52525b;
    border-bottom: 1px solid #52525b;
    background: linear-gradient(to bottom, #3f3f46, #27272a);
  }

  .mockup-foot {
    width: min(20rem, 80%);
    margin: 0.125rem auto 0;
    height: 0.5rem;
    background: linear-gradient(to right, #27272a, #52525b, #27272a);
    border-radius: 7px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
  }

  /* ---------- Laptop ---------- */
  /* Flotante abajo a la izquierda, simétrica al teléfono de la derecha.
     El ancho del contenedor ES el ancho de la base; la pantalla va al 88% adentro.
     Así la base sobresale a los costados sin salirse del contenedor, que es lo que
     la dejaría recortada contra el `overflow: hidden` de la página. */
  .laptop {
    display: none;
    position: absolute;
    left: -9.25rem;
    bottom: -1.5rem;
    width: 19rem;
    z-index: 10;
  }

  .laptop__screen {
    position: relative;
    width: 550px;
    margin: 0 auto;
    padding: 0.4rem 0.4rem 0;
    background: #0c0c0e;
    border: 2px solid rgba(63, 63, 70, 0.8);
    border-bottom: 0;
    border-radius: 7px 7px 0 0;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }

  .laptop__img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: 7px 7px 0 0;
  }

  /* El teclado: más ancho que la pantalla y con la bisagra redondeada */
  .laptop__base {
    position: relative;
    width: 550px;
    height: 0.55rem;
    border: 1px solid #52525b;
    border-top: 0;
    border-radius: 0 0 7px 7px;
    background: linear-gradient(to bottom, #3f3f46, #27272a);
    box-shadow: 0 20px 40px -14px rgba(0, 0, 0, 0.9);
  }

  /* Muesca de apertura de la tapa */
  .laptop__base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 20%;
    height: 0.15rem;
    border-radius: 0 0 7px 7px;
    background: #18181b;
  }

  /* ---------- Teléfono ---------- */
  .mockup-phone {
    display: none;
    position: absolute;
    right: -1.25rem;
    bottom: -1.5rem;
    width: 8.5rem;
    z-index: 10;
  }

  .mockup-phone__frame {
    position: relative;
    background: #0c0c0e;
    border: 2px solid rgba(63, 63, 70, 0.8);
    border-radius: 7px;
    padding: 0.4rem;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.8);
  }

  .mockup-phone__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem 0.25rem;
    color: #ffffff;
    font-size: 0.5625rem;
    font-weight: 600;
  }

  .mockup-phone__notch {
    width: 2.75rem;
    height: 0.625rem;
    border-radius: 7px;
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .mockup-phone__img {
    width: 100%;
    aspect-ratio: 9 / 19;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Barra de navegación Android (retroceso, inicio, recientes) */
  .mockup-phone__nav {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0.3rem 1rem 0.4rem;
    background: #000000;
  }
  .mockup-phone__nav svg {
    width: 0.7rem;
    height: 0.7rem;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 560px) {
    .mockup-phone {
      display: block;
    }
  }

  /* La laptop entra más tarde que el teléfono: un cluster de tres dispositivos
     necesita ancho. Debajo de 1024px el mockup llena el ancho disponible y la
     laptop taparía el monitor entero. */
  @media (min-width: 1024px) {
    .laptop {
      display: block;
    }
  }

  @media (min-width: 1200px) {
    .mockup-phone {
      width: 9.5rem;
    }
    .laptop {
      width: 23rem;
    }
  }
</style>
