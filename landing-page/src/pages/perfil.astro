---
import Layout from '../layouts/Layout.astro';
import ProfileLoading from '../sections/perfil/ProfileLoading.astro';
import ProfileEmpty from '../sections/perfil/ProfileEmpty.astro';
import ProfileStore from '../sections/perfil/ProfileStore.astro';
import ProfileSubscription from '../sections/perfil/ProfileSubscription.astro';
import ProfileBilling from '../sections/perfil/ProfileBilling.astro';
import ProfileDangerZone from '../sections/perfil/ProfileDangerZone.astro';
---

<Layout
  title="Tu perfil · CajoraPOS"
  description="Tu tienda y el estado de tu suscripción."
>
  <main class="profile container-narrow">
    <ProfileLoading />
    <ProfileEmpty />

    <!-- Contenido -->
    <div data-profile-content hidden>
      <h1 class="profile__title">Tu perfil</h1>
      <p class="profile__lead">Datos de tu tienda y estado de tu suscripción.</p>

      <div class="profile__grid">
        <ProfileStore />
        <ProfileSubscription />
      </div>

      <ProfileBilling />

      <ProfileDangerZone />
    </div>
  </main>
</Layout>

<script>
  import { goToPosWithSso } from "../lib/sso";
  import { readSession, clearSession } from "../lib/session";
  import { renderSub, initSubscriptionActions } from "../lib/profile/subscription";
  import { renderBilling } from "../lib/profile/billing";
  import { initStoreForm } from "../lib/profile/store";
  (() => {
    const $ = (sel) => document.querySelector(sel);

    const apiUrl = import.meta.env.PUBLIC_API_URL;
    const posUrl = import.meta.env.PUBLIC_POS_URL;
    const homeUrl = import.meta.env.BASE_URL;

    const loading = $("[data-profile-loading]");
    const empty = $("[data-profile-empty]");
    const content = $("[data-profile-content]");

    const showEmpty = (title, text) => {
      loading.hidden = true;
      content.hidden = true;
      empty.hidden = false;
      $("[data-empty-title]").textContent = title;
      $("[data-empty-text]").textContent = text;
    };

    const session = readSession();
    if (!session?.accessToken) {
      showEmpty("No estás logueado", "Creá tu tienda o iniciá sesión para ver tu perfil y el estado de tu suscripción.");
      return;
    }

    const authHeaders = { Authorization: `Bearer ${session.accessToken}` };

    // -------- Cerrar sesión --------
    $("[data-logout]").addEventListener("click", async () => {
      if (session.refreshToken) {
        try {
          await fetch(`${apiUrl}/auth/logout`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ refreshToken: session.refreshToken }),
          });
        } catch {
          /* best effort: la sesión local se limpia igual */
        }
      }
      clearSession();
      window.location.href = homeUrl;
    });

    // -------- CTA "Ir a mi tienda" --------
    const cta = $("[data-profile-cta]");
    cta.addEventListener("click", (e) => {
      if (cta.getAttribute("href") === posUrl) {
        e.preventDefault();
        void goToPosWithSso();
      }
    });

    // -------- Carga inicial --------
    (async () => {
      try {
        const [subRes, settingsRes] = await Promise.all([
          fetch(`${apiUrl}/subscriptions/mine`, { headers: authHeaders }),
          fetch(`${apiUrl}/settings`, { headers: authHeaders }).catch(() => null),
        ]);

        if (subRes.status === 401) {
          showEmpty(
            "Tu sesión expiró",
            "Iniciá sesión de nuevo para ver tu perfil y el estado de tu suscripción.",
          );
          return;
        }
        if (!subRes.ok) throw new Error("No se pudo cargar la suscripción.");

        const sub = await subRes.json();
        loading.hidden = true;
        empty.hidden = true;
        content.hidden = false;

        // Tienda: preferimos los datos reales de /settings; email siempre de la sesión.
        let settings = null;
        if (settingsRes && settingsRes.ok) {
          settings = await settingsRes.json().catch(() => null);
        }
        $("[data-store-name]").value = settings?.name ?? session.storeName ?? "";
        $("[data-store-address]").value = settings?.address ?? "";
        $("[data-store-phone]").value = settings?.phone ?? "";
        $("[data-store-email]").value = session.email ?? "";

        renderSub(sub);
        void renderBilling(authHeaders);
        initStoreForm(authHeaders);
        initSubscriptionActions(authHeaders);
      } catch (err) {
        showEmpty(
          "No se pudo cargar tu perfil",
          "Hubo un problema al consultar el estado. Intentalo de nuevo en unos minutos.",
        );
      }
    })();
  })();
</script>

<style>
  .profile {
    /* padding superior: header fijo (64px) + aire */
    padding-top: calc(64px + 2rem);
    padding-bottom: 5rem;
  }

  .profile__title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .profile__lead {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .profile__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .profile__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
