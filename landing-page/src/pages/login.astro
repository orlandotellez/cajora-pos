---
import Layout from '../layouts/Layout.astro';
import LoginBrand from '../sections/login/LoginBrand.astro';
import LoginForm from '../sections/login/LoginForm.astro';
---

<Layout
  title="Iniciar sesión · CajoraPos"
  description="Ingresá a tu tienda."
>

  <main class="login">
    <LoginBrand />
    <LoginForm />
  </main>

</Layout>

<script>
  import { initLoginForm } from "../lib/auth/login";
  (() => {
    initLoginForm();
  })();
</script>

<style>
  .login {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 64px);
  }

  @media (max-width: 768px) {
    .login {
      grid-template-columns: 1fr;
      padding-top: 64px;
    }
  }
</style>