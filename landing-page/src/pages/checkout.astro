---
import Layout from '../layouts/Layout.astro';
import CheckoutSteps from '../sections/checkout/CheckoutSteps.astro';
import CheckoutRegister from '../sections/checkout/CheckoutRegister.astro';
import CheckoutLogin from '../sections/checkout/CheckoutLogin.astro';
import CheckoutVerify from '../sections/checkout/CheckoutVerify.astro';
import CheckoutPay from '../sections/checkout/CheckoutPay.astro';
import CheckoutSuccess from '../sections/checkout/CheckoutSuccess.astro';
import CheckoutSummary from '../sections/checkout/CheckoutSummary.astro';
import PlansModal from '../sections/checkout/PlansModal.astro';
---

<Layout
  title="Checkout · CajoraPOS"
  description="Crea tu tienda y activa tu suscripción Cloud."
>

  <main class="checkout container-narrow">
    <CheckoutSteps />

    <div class="checkout__grid">
      <!-- Columna principal: los pasos -->
      <section class="checkout__card" aria-label="Checkout">
        <CheckoutRegister />
        <CheckoutLogin />
        <CheckoutVerify />
        <CheckoutPay />
        <CheckoutSuccess />
      </section>

      <CheckoutSummary />
    </div>
  </main>

  <PlansModal />

</Layout>

<script>
  import { goToPosWithSso } from "../lib/sso";
  import { readSession, saveSession, clearSession } from "../lib/session";
  import { setStep, initStepsNavigation } from "../lib/checkout/steps";
  import { initRegister, initCheckoutLogin } from "../lib/checkout/register";
  import { initVerify, enterVerifyPanel } from "../lib/checkout/verify";
  import { createPaypal } from "../lib/checkout/paypal";
  import { initPlans } from "../lib/checkout/plans";

  (() => {
    const $ = (sel: string): HTMLElement | null => document.querySelector(sel);
    const $$ = (sel: string): HTMLElement[] => [...document.querySelectorAll<HTMLElement>(sel)];

    const apiUrl = import.meta.env.PUBLIC_API_URL;
    const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
    const posUrl = import.meta.env.PUBLIC_POS_URL;
    const paypalSandbox = import.meta.env.PUBLIC_PAYPAL_SANDBOX === "true";

    const hideError = (el: HTMLElement): void => { el.hidden = true; };

    const summaryStore = $("[data-summary-store]")!;
    const summaryEmail = $("[data-summary-email]")!;
    const payError = $("[data-pay-error]")!;
    const payButtons = $("[data-pay-buttons]")!;
    const payLoading = $("[data-pay-loading]")!;
    const paySuccess = $("[data-pay-success]")!;

    let accessToken: string | null = null;

    const setSummary = (storeName: string | null, email: string | null): void => {
      summaryStore.textContent = storeName || "—";
      summaryEmail.textContent = email || "—";
    };

    // Sesión inválida/vencida (o no verificable) → checkout desde cero.
    const resetToStart = (): void => {
      clearSession();
      accessToken = null;
      payButtons.innerHTML = "";
      payLoading.hidden = true;
      setSummary("—", "—");
      setStep(1, null);
    };

    const paypal = createPaypal({
      apiUrl,
      clientId: paypalClientId,
      posUrl,
      sandbox: paypalSandbox,
      getToken: () => accessToken,
      onReset: () => resetToStart(),
      onActivated: () => setStep(4, readSession()),
    });

    // Tras registrarse/loguearse: si el email está verificado → pago; si no → verificación.
    async function afterAuth(storeName: string | null, email: string, emailVerified: boolean, sendCodeOnEnter: boolean): Promise<void> {
      setSummary(storeName, email);
      if (!emailVerified) {
        await enterVerify(email, sendCodeOnEnter);
        return;
      }
      await enterPay(storeName, email);
    }

    async function enterVerify(email: string, autoSend: boolean): Promise<void> {
      setStep(2, readSession());
      await enterVerifyPanel(email, autoSend);
    }

    async function enterPay(storeName: string | null, email: string | null): Promise<void> {
      hideError(payError);
      setSummary(storeName, email);
      if (storeName) {
        $("[data-success-store]")!.textContent = storeName;
        paySuccess.hidden = false;
      }
      setStep(3, readSession());
      if (payButtons.childElementCount === 0) {
        await paypal.mount();
        saveSession({ ...(readSession() ?? {}), paypalMounted: true });
      }
    }

    document.querySelectorAll<HTMLAnchorElement>("[data-go-pos]").forEach((a) => {
      a.href = posUrl;
      a.addEventListener("click", (e) => { e.preventDefault(); void goToPosWithSso(); });
    });

    $$("[data-toggle-password]").forEach((btn) => btn.addEventListener("click", () => {
      const input = btn.closest<HTMLElement>(".field-password")?.querySelector<HTMLInputElement>("input");
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
      btn.classList.toggle("is-visible", show);
    }));

    $$("[data-reset], [data-verify-change-account]").forEach((btn) => btn.addEventListener("click", () => { clearSession(); window.location.reload(); }));

    initPlans();
    initStepsNavigation({ onEnterPay: () => { if (payButtons.childElementCount === 0) void paypal.mount(); } });

    initRegister({
      apiUrl,
      onAuth: afterAuth,
      onSummaryChange: setSummary,
      onToken: (t) => { accessToken = t; },
    });

    initVerify({
      apiUrl,
      onVerified: async (updated) => {
        accessToken = updated.accessToken ?? accessToken;
        saveSession(updated);
        await enterPay(updated.storeName ?? null, updated.email ?? "");
      },
      onNoSession: resetToStart,
    });

    initCheckoutLogin({ onAuth: afterAuth, onToken: (t) => { accessToken = t; } });

    // Reanudar sesión guardada en sessionStorage.
    async function resumeFlow(): Promise<void> {
      const session = readSession();
      if (!session?.accessToken) {
        setStep(1, null);
        return;
      }
      accessToken = session.accessToken;

      try {
        const res = await fetch(`${apiUrl}/subscriptions/mine`, {
          headers: { Authorization: `Bearer ${accessToken}` },
        });
        const data = (await res.json().catch(() => null)) as { status?: string; mode?: string } | null;

        // Solo una suscripción Cloud real cuenta como activa.
        if (res.ok && data?.status === "active" && data?.mode === "cloud") {
          saveSession({ ...session, paid: true, emailVerified: true });
          setSummary(session.storeName ?? null, session.email ?? null);
          setStep(4, readSession());
          return;
        }
        if (res.ok) {
          // Sesión válida → verificar email si falta, si no → pago.
          setSummary(session.storeName ?? null, session.email ?? null);
          if (session.emailVerified) {
            await enterPay(session.storeName ?? null, session.email ?? null);
          } else {
            await enterVerify(session.email ?? "", false);
          }
          return;
        }
        // Token inválido/vencido (401/403) o error del servidor → empezar desde cero.
        resetToStart();
      } catch {
        // No se pudo verificar la sesión → checkout limpio.
        resetToStart();
      }
    }

    void resumeFlow();
  })();
</script>

<style>
  .checkout {
    padding-top: calc(64px + 2rem);
    padding-bottom: 5rem;
  }

  .checkout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  .checkout__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2.5rem;
  }

  @media (min-width: 900px) {
    .checkout__grid {
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .checkout__card {
      padding: 1.5rem;
    }
  }

  @media (max-width: 400px) {
    .checkout__card {
      padding: 1.25rem;
    }
  }
</style>
