---
import Layout from '../layouts/Layout.astro';
import CheckoutSteps from '../sections/checkout/CheckoutSteps.astro';
import CheckoutRegister from '../sections/checkout/CheckoutRegister.astro';
import CheckoutLogin from '../sections/checkout/CheckoutLogin.astro';
import CheckoutVerify from '../sections/checkout/CheckoutVerify.astro';
import CheckoutPay from '../sections/checkout/CheckoutPay.astro';
import CheckoutSuccess from '../sections/checkout/CheckoutSuccess.astro';
import CheckoutSummary from '../sections/checkout/CheckoutSummary.astro';
import PlansModal from '../sections/checkout/PlansModal.astro';
---

<Layout
  title="Checkout · CajoraPOS"
  description="Crea tu tienda y activa tu suscripción Cloud."
>

  <main class="checkout container-narrow">
    <CheckoutSteps />

    <div class="checkout__grid">
      <!-- Columna principal: los pasos -->
      <section class="checkout__card" aria-label="Checkout">
        <CheckoutRegister />
        <CheckoutLogin />
        <CheckoutVerify />
        <CheckoutPay />
        <CheckoutSuccess />
      </section>

      <CheckoutSummary />
    </div>
  </main>

  <PlansModal />

</Layout>

<script>
  import { goToPosWithSso } from "../lib/sso";
  import { readSession, saveSession, clearSession } from "../lib/session";
  import { setStep, initStepsNavigation } from "../lib/checkout/steps";
  import { initRegister, initCheckoutLogin } from "../lib/checkout/register";
  import { initVerify, enterVerifyPanel } from "../lib/checkout/verify";
  import { createPaypal } from "../lib/checkout/paypal";
  import { createWhop } from "../lib/checkout/whop";
  import { initPlans } from "../lib/checkout/plans";

  (() => {
    const $ = (sel: string): HTMLElement | null => document.querySelector(sel);
    const $$ = (sel: string): HTMLElement[] => [...document.querySelectorAll<HTMLElement>(sel)];

    const apiUrl = import.meta.env.PUBLIC_API_URL;
    const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
    const whopPlanId = import.meta.env.PUBLIC_WHOP_PLAN_ID as string | undefined;
    const posUrl = import.meta.env.PUBLIC_POS_URL;
    const paypalSandbox = import.meta.env.PUBLIC_PAYPAL_SANDBOX === "true";
    const isNativeApp = "__TAURI__" in window;

    const hideError = (el: HTMLElement): void => { el.hidden = true; };
    const showError = (el: HTMLElement, msg: string): void => { el.textContent = msg; el.hidden = false; };

    const summaryStore = $("[data-summary-store]")!;
    const summaryEmail = $("[data-summary-email]")!;
    const payError = $("[data-pay-error]")!;
    const payButtons = $("[data-pay-buttons]")!;
    const payLoading = $("[data-pay-loading]")!;
    const paySuccess = $("[data-pay-success]")!;
    const whopBlock = $("[data-whop-block]");
    const whopTarget = $("[data-whop-checkout]");
    const whopPending = $("[data-whop-pending]");
    const whopSwitch = $("[data-whop-switch]");
    const whopSync = $("[data-whop-sync]") as HTMLButtonElement | null;
    const whopSyncStatus = $("[data-whop-sync-status]");

    // Regreso del checkout off-site de Whop: Whop agrega `payment` y `status`.
    const returnParams = new URLSearchParams(window.location.search);
    const whopReturn = returnParams.get("whop") === "1";
    const whopReturnStatus = returnParams.get("status");
    const whopReturnFailed = whopReturnStatus === "failed" || whopReturnStatus === "canceled";

    // Confirmación post-Whop: pocos intentos con espera entre ellos, nunca infinita.
    const WHOP_CONFIRM_ATTEMPTS = 8;
    const WHOP_CONFIRM_DELAY_MS = 2500;
    const delay = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));

    let accessToken: string | null = null;

    // Auth idéntico al resto del checkout: cookies en web, Bearer bajo Tauri.
    function authFetch(path: string, init: RequestInit = {}): Promise<Response> {
      const headers: Record<string, string> = { ...((init.headers as Record<string, string>) ?? {}) };
      const opts: RequestInit = { ...init };
      if (isNativeApp && accessToken) {
        headers.Authorization = `Bearer ${accessToken}`;
      } else if (!isNativeApp) {
        opts.credentials = "include";
      }
      return fetch(`${apiUrl}${path}`, { ...opts, headers });
    }

    // Limpia `whop`/`status`/`payment` una vez manejados para que una recarga no
    // vuelva a disparar el flujo de confirmación.
    function clearWhopParams(): void {
      const url = new URL(window.location.href);
      if (!url.searchParams.has("whop") && !url.searchParams.has("status") && !url.searchParams.has("payment")) return;
      url.searchParams.delete("whop");
      url.searchParams.delete("status");
      url.searchParams.delete("payment");
      window.history.replaceState({}, "", url);
    }

    // Solo el registro exitoso puede decir "tienda creada". Login, sesión reanudada y
    // verificación de email llegan al mismo paso de pago con una tienda que ya existía
    // hace meses, y ahí el copy tiene que hablar de volver a suscribirse.
    type PayOrigin = "created" | "returning";
    const SUCCESS_COPY: Record<PayOrigin, { prefix: string; suffix: string }> = {
      created: { prefix: "✓ Tienda ", suffix: " creada — completá el pago abajo." },
      returning: {
        prefix: "✓ Volvés a ",
        suffix: " — completá el pago para volver a activar tu plan Cloud.",
      },
    };
    let flowOrigin: PayOrigin = "returning";

    const setSummary = (storeName: string | null, email: string | null): void => {
      summaryStore.textContent = storeName || "—";
      summaryEmail.textContent = email || "—";
    };

    // Sesión inválida/vencida (o no verificable) → checkout desde cero.
    const resetToStart = (): void => {
      clearSession();
      accessToken = null;
      flowOrigin = "returning";
      payButtons.innerHTML = "";
      payLoading.hidden = true;
      if (whopTarget) whopTarget.innerHTML = "";
      if (whopBlock) whopBlock.hidden = true;
      if (whopPending) whopPending.hidden = true;
      if (whopSyncStatus) whopSyncStatus.hidden = true;
      setSummary("—", "—");
      setStep(1, null);
    };

    const paypal = createPaypal({
      apiUrl,
      clientId: paypalClientId,
      posUrl,
      sandbox: paypalSandbox,
      getToken: () => accessToken,
      onReset: () => resetToStart(),
      onActivated: () => setStep(4, readSession()),
    });

    // Whop solo existe cuando hay plan configurado en el build.
    const whop = whopPlanId
      ? createWhop({
          apiUrl,
          planId: whopPlanId,
          posBaseUrl: posUrl,
          getToken: () => accessToken,
          onReset: () => resetToStart(),
          onError: (message) => showError(payError, message),
        })
      : null;

    // Método primario del paso 3: Whop si está configurado, si no PayPal como hoy.
    async function mountPrimary(): Promise<void> {
      if (whop) {
        if (whopTarget && whopTarget.childElementCount === 0) {
          await whop.mount();
        }
        return;
      }
      if (payButtons.childElementCount === 0) {
        await paypal.mount();
        saveSession({ ...(readSession() ?? {}), paypalMounted: true });
      }
    }

    // Tras registrarse/loguearse: si el email está verificado → pago; si no → verificación.
    async function afterAuth(storeName: string | null, email: string, emailVerified: boolean, sendCodeOnEnter: boolean, origin: PayOrigin = "returning"): Promise<void> {
      flowOrigin = origin;
      setSummary(storeName, email);
      if (!emailVerified) {
        await enterVerify(email, sendCodeOnEnter);
        return;
      }
      await enterPay(storeName, email);
    }

    async function enterVerify(email: string, autoSend: boolean): Promise<void> {
      setStep(2, readSession());
      await enterVerifyPanel(email, autoSend);
    }

    async function enterPay(storeName: string | null, email: string | null): Promise<void> {
      hideError(payError);
      setSummary(storeName, email);
      paySuccess.hidden = true;
      if (whopSyncStatus) whopSyncStatus.hidden = true;
      if (storeName) {
        const copy = SUCCESS_COPY[flowOrigin];
        $("[data-success-prefix]")!.textContent = copy.prefix;
        $("[data-success-store]")!.textContent = storeName;
        $("[data-success-suffix]")!.textContent = copy.suffix;
        paySuccess.hidden = false;
      }
      setStep(3, readSession());
      await mountPrimary();
    }

    // El query param solo dice que el comprador volvió; NUNCA es prueba de pago.
    // La única autoridad es el backend: el webhook de Whop escribe la suscripción
    // y acá se confirma contra `GET /subscriptions/mine`.
    async function confirmWhopPayment(): Promise<void> {
      hideError(payError);
      if (whopBlock) whopBlock.hidden = false;
      if (whopTarget) whopTarget.hidden = true;
      if (whopPending) {
        whopPending.textContent = "Estamos confirmando el pago con Whop. Esto puede tardar unos segundos…";
        whopPending.hidden = false;
      }
      setStep(3, readSession());

      for (let attempt = 1; attempt <= WHOP_CONFIRM_ATTEMPTS; attempt++) {
        let res: Response | null = null;
        try {
          res = await authFetch("/subscriptions/mine");
        } catch {
          // Error de red transitorio: se trata como "todavía no acreditado".
          res = null;
        }

        if (res) {
          const data = (await res.json().catch(() => null)) as { status?: string; mode?: string } | null;

          if (res.ok && data?.status === "active" && data?.mode === "cloud") {
            clearWhopParams();
            saveSession({ ...(readSession() ?? {}), paid: true, emailVerified: true });
            setStep(4, readSession());
            return;
          }
          if (res.status === 401 || res.status === 403) {
            clearWhopParams();
            resetToStart();
            return;
          }
        }
        if (attempt < WHOP_CONFIRM_ATTEMPTS) await delay(WHOP_CONFIRM_DELAY_MS);
      }

      // Se agotaron los intentos: se mantiene el mensaje pendiente y NO se avanza
      // ni se marca `paid`. El acceso se confirma por email cuando Whop acredita.
      clearWhopParams();
      if (whopPending) {
        whopPending.textContent =
          "Seguimos confirmando tu pago. Te avisamos por email en cuanto Whop lo acredite; podés cerrar esta página.";
        whopPending.hidden = false;
      }
    }

    // Recuperación manual: si el comprador ya pagó y la fila quedó `pending` (webhook
    // demorado / sin retorno al landing), se reconcilia contra Whop sin volver a
    // cobrar. La autoridad sigue siendo el backend, igual que en el polling.
    async function syncWhopPayment(): Promise<void> {
      if (!whopSync) return;
      hideError(payError);
      whopSync.disabled = true;
      if (whopSyncStatus) {
        whopSyncStatus.textContent = "Consultando tu pago con Whop…";
        whopSyncStatus.hidden = false;
      }

      try {
        // POST sin body: no se envía `Content-Type`, así Fastify no rechaza un JSON vacío.
        const res = await authFetch("/subscriptions/whop/sync", { method: "POST" });
        const data = (await res.json().catch(() => null)) as { status?: string; mode?: string } | null;

        if (res.status === 401 || res.status === 403) {
          resetToStart();
          return;
        }
        // Solo una suscripción Cloud realmente activa habilita el paso 4.
        if (res.ok && data?.status === "active" && data?.mode === "cloud") {
          saveSession({ ...(readSession() ?? {}), paid: true, emailVerified: true });
          setStep(4, readSession());
          return;
        }
        // Todavía no acreditado: mensaje calmo y nunca se marca el pago a mano.
        if (whopSyncStatus) {
          whopSyncStatus.textContent =
            "Todavía no vemos tu pago. Esperá un minuto y volvé a intentar; te confirmamos el acceso por email cuando Whop lo acredite.";
          whopSyncStatus.hidden = false;
        }
      } catch {
        if (whopSyncStatus) {
          whopSyncStatus.textContent =
            "No pudimos verificar tu pago ahora. Revisá tu conexión e intentá de nuevo en un minuto.";
          whopSyncStatus.hidden = false;
        }
      } finally {
        whopSync.disabled = false;
      }
    }

    if (whopSync) {
      whopSync.addEventListener("click", () => { void syncWhopPayment(); });
    }

    document.querySelectorAll<HTMLAnchorElement>("[data-go-pos]").forEach((a) => {
      a.href = posUrl;
      a.addEventListener("click", (e) => { e.preventDefault(); void goToPosWithSso(); });
    });

    $$("[data-toggle-password]").forEach((btn) => btn.addEventListener("click", () => {
      const input = btn.closest<HTMLElement>(".field-password")?.querySelector<HTMLInputElement>("input");
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
      btn.classList.toggle("is-visible", show);
    }));

    $$("[data-reset], [data-verify-change-account]").forEach((btn) => btn.addEventListener("click", () => { clearSession(); window.location.reload(); }));

    // La segunda opción (PayPal) se revela y monta solo cuando el comprador la elige.
    if (whopSwitch) {
      whopSwitch.addEventListener("click", () => {
        if (whopBlock) whopBlock.hidden = true;
        if (whopPending) whopPending.hidden = true;
        whopSwitch.hidden = true;
        payButtons.hidden = false;
        if (payButtons.childElementCount === 0) void paypal.mount();
      });
    }

    initPlans();
    initStepsNavigation({ onEnterPay: () => { void mountPrimary(); } });

    initRegister({
      apiUrl,
      onAuth: afterAuth,
      onSummaryChange: setSummary,
      onToken: (t) => { accessToken = t; },
    });

    initVerify({
      apiUrl,
      onVerified: async (updated) => {
        accessToken = updated.accessToken ?? accessToken;
        saveSession(updated);
        await enterPay(updated.storeName ?? null, updated.email ?? "");
      },
      onNoSession: resetToStart,
    });

    initCheckoutLogin({ apiUrl, onAuth: afterAuth, onToken: (t) => { accessToken = t; } });

    // Reanudar sesión guardada (cookies en web, localStorage en desktop).
    async function resumeFlow(): Promise<void> {
      const session = readSession();
      const hasToken = isNativeApp ? !!session?.accessToken : !!session?.email;
      if (!hasToken) {
        clearWhopParams();
        setStep(1, null);
        return;
      }
      accessToken = session?.accessToken ?? null;

      try {
        const res = await authFetch("/subscriptions/mine");
        const data = (await res.json().catch(() => null)) as { status?: string; mode?: string } | null;

        // Solo una suscripción Cloud real cuenta como activa.
        if (res.ok && data?.status === "active" && data?.mode === "cloud") {
          clearWhopParams();
          saveSession({ ...session, paid: true, emailVerified: true });
          setSummary(session.storeName ?? null, session.email ?? null);
          setStep(4, readSession());
          return;
        }
        if (res.ok) {
          // Sesión válida → verificar email si falta, si no → pago.
          setSummary(session.storeName ?? null, session.email ?? null);
          if (!session.emailVerified) {
            clearWhopParams();
            await enterVerify(session.email ?? "", false);
            return;
          }
          // Regreso del checkout off-site de Whop.
          if (whopReturn) {
            if (whopReturnFailed) {
              // `failed`/`canceled`: no se cobró nada → volver al paso 3 con reintento.
              clearWhopParams();
              await enterPay(session.storeName ?? null, session.email ?? null);
              showError(payError, "No se completó el pago y no se te cobró nada. Podés intentarlo de nuevo.");
              return;
            }
            await confirmWhopPayment();
            return;
          }
          await enterPay(session.storeName ?? null, session.email ?? null);
          return;
        }
        // Token inválido/vencido (401/403) o error del servidor → empezar desde cero.
        clearWhopParams();
        resetToStart();
      } catch {
        // No se pudo verificar la sesión → checkout limpio.
        clearWhopParams();
        resetToStart();
      }
    }

    void resumeFlow();
  })();
</script>

<style>
  .checkout {
    padding-top: calc(64px + 2rem);
    padding-bottom: 5rem;
  }

  .checkout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  .checkout__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2.5rem;
  }

  @media (min-width: 900px) {
    .checkout__grid {
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .checkout__card {
      padding: 1.5rem;
    }
  }

  @media (max-width: 400px) {
    .checkout__card {
      padding: 1.25rem;
    }
  }
</style>
