---
import Layout from '../layouts/Layout.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';
---

<Layout
  title="Checkout · CajoraPos"
  description="Crea tu tienda y activa tu suscripción Cloud."
>
  <Header />

  <main class="checkout container-narrow">
    <ol class="checkout__steps" data-steps aria-label="Progreso del checkout">
      <li class="checkout__step" data-step="1">
        <span class="checkout__step-num">1</span>
        Tu tienda
      </li>
      <li class="checkout__step" data-step="2">
        <span class="checkout__step-num">2</span>
        Confirmar correo
      </li>
      <li class="checkout__step" data-step="3">
        <span class="checkout__step-num">3</span>
        Pago
      </li>
      <li class="checkout__step" data-step="4">
        <span class="checkout__step-num">4</span>
        Listo
      </li>
    </ol>

    <div class="checkout__grid">
      <!-- Columna principal: los pasos -->
      <section class="checkout__card" aria-label="Checkout">
        <div data-step-panel="1">
          <h1 class="checkout__title">Creá tu tienda</h1>
          <p class="checkout__lead">
            <strong>14 días gratis</strong> · luego $15.99/mes. Podés pagar ahora o al finalizar el trial.
            <button type="button" class="checkout__link checkout__link-inline" data-plans-open>Ver planes</button>
          </p>

          <form class="checkout__form-fields" data-register-form novalidate>
            <label class="checkout__field">
              <span>Nombre de la tienda</span>
              <input type="text" name="storeName" placeholder="Mi Tienda" required minlength="2" />
            </label>

            <label class="checkout__field">
              <span>Tu nombre</span>
              <input type="text" name="adminName" placeholder="Juan Pérez" required minlength="2" />
            </label>

            <label class="checkout__field">
              <span>Email</span>
              <input type="email" name="adminEmail" placeholder="tucorreo@ejemplo.com" required />
            </label>

            <label class="checkout__field">
              <span>Contraseña</span>
              <span class="field-password">
                <input type="password" name="adminPassword" placeholder="Mínimo 8 caracteres" required minlength="8" />
                <button type="button" class="field-password__toggle" data-toggle-password aria-label="Mostrar contraseña">
                  <svg class="field-password__eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg class="field-password__eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/>
                    <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/>
                    <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/>
                    <path d="m2 2 20 20"/>
                  </svg>
                </button>
              </span>
            </label>

            <p class="checkout__error" data-register-error role="alert" hidden></p>

            <button type="submit" class="btn-primary checkout__submit" data-register-submit disabled>
              Crear cuenta y continuar
            </button>
            <p class="checkout__hint" data-register-hint>Completá todos los campos para continuar.</p>
          </form>

          <p class="checkout__switch">
            ¿Ya tenés una cuenta?
            <button type="button" class="checkout__link" data-toggle="login">Iniciá sesión</button>
          </p>
        </div>

        <div data-step-panel="1" data-login-panel hidden>
          <h1 class="checkout__title">Iniciá sesión</h1>
          <p class="checkout__lead">
            Ingresá con la cuenta de tu tienda para continuar con el pago.
          </p>

          <form class="checkout__form-fields" data-login-form novalidate>
            <label class="checkout__field">
              <span>Email</span>
              <input type="email" name="email" placeholder="tucorreo@ejemplo.com" required />
            </label>

            <label class="checkout__field">
              <span>Contraseña</span>
              <span class="field-password">
                <input type="password" name="password" placeholder="Tu contraseña" required minlength="8" />
                <button type="button" class="field-password__toggle" data-toggle-password aria-label="Mostrar contraseña">
                  <svg class="field-password__eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg class="field-password__eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/>
                    <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/>
                    <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/>
                    <path d="m2 2 20 20"/>
                  </svg>
                </button>
              </span>
            </label>

            <p class="checkout__error" data-login-error role="alert" hidden></p>

            <button type="submit" class="btn-primary checkout__submit" data-login-submit disabled>
              Iniciar sesión y continuar
            </button>
          </form>

          <p class="checkout__switch">
            ¿No tenés cuenta?
            <button type="button" class="checkout__link" data-toggle="register">Crear cuenta</button>
          </p>
        </div>

        <!-- Paso 2: confirmar correo -->
        <div data-step-panel="2" hidden>
          <h1 class="checkout__title">Confirmá tu correo</h1>
          <p class="checkout__lead">
            Te enviamos un código de verificación a <strong data-verify-email></strong>.
            Ingresalo abajo para continuar con el pago.
          </p>

          <div class="checkout__success" data-verify-success hidden>
            ✓ Correo verificado — ya podés continuar con el pago.
          </div>

          <form class="checkout__form-fields" data-verify-form novalidate>
            <label class="checkout__field">
              <span>Código de verificación</span>
              <input
                type="text"
                name="code"
                placeholder="Ej: 4K7M2P"
                required
                minlength="6"
                maxlength="6"
                autocomplete="one-time-code"
                inputmode="text"
                data-verify-input
              />
            </label>

            <p class="checkout__error" data-verify-error role="alert" hidden></p>

            <button type="submit" class="btn-primary checkout__submit" data-verify-submit disabled>
              Verificar correo
            </button>
            <p class="checkout__hint" data-verify-hint>Ingresá el código de 6 caracteres que recibiste.</p>
          </form>

          <div class="checkout__switch">
            ¿No te llegó el correo?
            <button type="button" class="checkout__link" data-resend-code>Reenviar código</button>
          </div>

          <div class="pay__switch">
            <button type="button" class="checkout__link" data-verify-change-account>Cambiar de cuenta</button>
          </div>
        </div>

        <div data-step-panel="3" hidden>
          <h1 class="checkout__title">Activá tu suscripción</h1>
          <p class="checkout__lead">
            Elegí cómo pagar <strong>$15.99/mes</strong>. Podés cancelar cuando quieras.
            <button type="button" class="checkout__link checkout__link-inline" data-plans-open>Ver planes</button>
          </p>

          <div class="checkout__success" data-pay-success hidden>
            ✓ Tienda <strong data-success-store></strong> creada — completá el pago abajo.
          </div>

          <div id="paypal-buttons" data-pay-buttons></div>
          <div class="pay__loading" data-pay-loading role="status" hidden>
            <span class="pay__spinner" aria-hidden="true"></span>
            <span>Cargando método de pago...</span>
          </div>
          <p class="pay__error" data-pay-error role="alert" hidden></p>

          <div class="pay__skip">
            <a href="#" class="checkout__link" data-go-pos>
              Lo pago después — mi trial sigue activo
            </a>
          </div>
          <div class="pay__switch">
            <button type="button" class="checkout__link" data-reset>Cambiar de cuenta</button>
          </div>
        </div>

        <!-- Paso 4: listo -->
        <div data-step-panel="4" hidden>
          <h1 class="checkout__title">¡Suscripción activa! 🎉</h1>
          <p class="checkout__lead">
            Tu suscripción Cloud está activa. Ahora entrá a tu tienda y empezá a vender.
          </p>
          <a href="#" class="btn-primary checkout__submit" data-go-pos>Ir a mi tienda</a>
          <div class="pay__switch">
            <a href={import.meta.env.BASE_URL + 'perfil'} class="checkout__link">Ver mi perfil</a>
          </div>
        </div>
      </section>

      <aside class="checkout__summary" aria-label="Resumen del pedido">
        <h2 class="summary__title">Resumen</h2>

        <div class="summary__plan">
          <div>
            <span class="summary__plan-name">Suscripción Cloud</span>
            <span class="summary__plan-tag">Recomendado</span>
          </div>
          <div class="summary__plan-price">
            <span class="summary__amount">$15.99</span>
            <span class="summary__period">/mes</span>
          </div>
        </div>

        <p class="summary__trial">14 días de prueba gratis · sin tarjeta</p>

        <dl class="summary__store">
          <div class="summary__store-row">
            <dt>Tienda</dt>
            <dd data-summary-store>—</dd>
          </div>
          <div class="summary__store-row">
            <dt>Email</dt>
            <dd data-summary-email>—</dd>
          </div>
        </dl>

        <p class="summary__plans-link">
          <button type="button" class="checkout__link" data-plans-open>Comparar todos los planes</button>
        </p>
      </aside>
    </div>
  </main>

  <!-- Modal: visualización de planes existentes -->
  <div class="plans-modal" data-plans-modal hidden>
    <div class="plans-modal__backdrop" data-plans-close></div>
    <div class="plans-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="plans-title">
      <div class="plans-modal__head">
        <h2 id="plans-title" class="plans-modal__title">Planes disponibles</h2>
        <button type="button" class="plans-modal__close" data-plans-close aria-label="Cerrar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>
      <p class="plans-modal__subtitle">Elegí la opción que mejor se adapte a tu negocio.</p>

      <div class="plans-modal__grid">
        <!-- Self-hosted -->
        <article class="plans-modal__plan">
          <div class="plans-modal__plan-head">
            <h3 class="plans-modal__plan-title">Gratis · Self-hosted</h3>
            <div class="plans-modal__plan-price">
              <span class="plans-modal__amount">$0</span>
              <span class="plans-modal__period">/siempre</span>
            </div>
          </div>
          <ul class="plans-modal__list">
            <li><span class="plans-modal__check">✓</span> Instalación en servidor propio</li>
            <li><span class="plans-modal__check">✓</span> Productos y ventas ilimitadas</li>
            <li><span class="plans-modal__check">✓</span> Datos 100% privados</li>
            <li><span class="plans-modal__check">✓</span> Comunidad de soporte</li>
          </ul>
        </article>

        <!-- Cloud -->
        <article class="plans-modal__plan plans-modal__plan--featured">
          <span class="plans-modal__tag">Recomendado</span>
          <div class="plans-modal__plan-head">
            <h3 class="plans-modal__plan-title">Suscripción · Cloud</h3>
            <p class="plans-modal__trial">14 días de prueba gratis</p>
            <div class="plans-modal__plan-price">
              <span class="plans-modal__amount">$15.99</span>
              <span class="plans-modal__period">/mes</span>
            </div>
          </div>
          <ul class="plans-modal__list">
            <li><span class="plans-modal__check">✓</span> Respaldos automáticos diarios</li>
            <li><span class="plans-modal__check">✓</span> Soporte técnico prioritario</li>
            <li><span class="plans-modal__check">✓</span> Configuración asistida</li>
            <li><span class="plans-modal__check">✓</span> Acceso remoto desde cualquier lugar</li>
            <li><span class="plans-modal__check">✓</span> Actualizaciones automáticas</li>
          </ul>
          <button type="button" class="btn-primary plans-modal__cta" data-plans-close data-plans-select>
            Continuar con este plan
          </button>
        </article>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { goToPosWithSso } from "../lib/sso";
  (() => {
    const $ = (sel) => document.querySelector(sel);
    const $$ = (sel) => [...document.querySelectorAll(sel)];

    const apiUrl = import.meta.env.PUBLIC_API_URL;
    const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
    const posUrl = import.meta.env.PUBLIC_POS_URL;
    const paypalSandbox = import.meta.env.PUBLIC_PAYPAL_SANDBOX === "true";

    const SESSION_KEY = "caja_checkout";

    const readSession = () => {
      try {
        return JSON.parse(sessionStorage.getItem(SESSION_KEY));
      } catch {
        return null;
      }
    };
    const saveSession = (data) => sessionStorage.setItem(SESSION_KEY, JSON.stringify(data));
    const clearSession = () => sessionStorage.removeItem(SESSION_KEY);

    const showError = (el, msg) => {
      el.textContent = msg;
      el.hidden = false;
    };
    const hideError = (el) => {
      el.hidden = true;
    };

    const summaryStore = $("[data-summary-store]");
    const summaryEmail = $("[data-summary-email]");
    const payError = $("[data-pay-error]");
    const payButtons = $("[data-pay-buttons]");
    const payLoading = $("[data-pay-loading]");
    const paySuccess = $("[data-pay-success]");

    let accessToken = null;
    let currentStep = 1;

    const stepEls = $$("[data-step]");
    const registerPanel = $("[data-register-form]").closest("[data-step-panel]");
    const loginPanel = $("[data-login-panel]");

    const verifyForm = $("[data-verify-form]");
    const verifySubmit = $("[data-verify-submit]");
    const verifyInput = $("[data-verify-input]");
    const verifyError = $("[data-verify-error]");
    const verifyHint = $("[data-verify-hint]");
    const verifyEmailLabel = $("[data-verify-email]");
    const verifySuccess = $("[data-verify-success]");

    // Un paso es alcanzable si el usuario completó los anteriores.
    const canVisit = (step) => {
      const session = readSession();
      if (step === 1) return true;
      if (!session?.accessToken) return false;
      if (step === 2) return true;
      if (step === 3) return session.emailVerified === true;
      if (step === 4) return session.paid === true;
      return false;
    };

    const renderVerifyPanel = () => {
      const session = readSession();
      const verified = session?.emailVerified === true;
      verifySuccess.hidden = !verified;
      verifyForm.hidden = verified;
    };

    const setStep = (target) => {
      let current = target;
      if (!canVisit(current)) {
        // Paso no alcanzable → volver al paso visitable más alto.
        for (let n = current; n >= 1; n--) {
          if (canVisit(n)) {
            current = n;
            break;
          }
        }
      }

      $$("[data-step-panel]").forEach((el) => {
        el.hidden = el.dataset.stepPanel !== String(current);
      });
      if (current === 1) {
        loginPanel.hidden = true;
        registerPanel.hidden = false;
      }
      if (current === 2) {
        renderVerifyPanel();
      }
      stepEls.forEach((el) => {
        const n = Number(el.dataset.step);
        const reachable = canVisit(n);
        el.classList.toggle("is-active", n === current);
        el.classList.toggle("is-done", n < current);
        el.classList.toggle("is-clickable", n !== current && reachable);
        el.setAttribute("aria-current", n === current ? "step" : "false");
      });

      // Persistir el paso más lejano alcanzado (para resume tras recarga).
      const session = readSession();
      if (session?.accessToken && current > (session.maxStep ?? 1)) {
        saveSession({ ...session, maxStep: current });
      }

      currentStep = current;
      return current;
    };

    // Navegación entre pasos completados (retroceder/avanzar).
      stepEls.forEach((el) => {
        el.addEventListener("click", () => {
          const n = Number(el.dataset.step);
          if (n === currentStep || !canVisit(n)) return;
          setStep(n);
          if (n === 3 && payButtons.childElementCount === 0) {
            void mountPaypal();
          }
        });
      });

    const setSummary = (storeName, email) => {
      summaryStore.textContent = storeName || "—";
      summaryEmail.textContent = email || "—";
    };

    // Sesión inválida/vencida (o no verificable) → checkout desde cero, sin datos de tienda.
    const resetToStart = () => {
      clearSession();
      accessToken = null;
      payButtons.innerHTML = "";
      payLoading.hidden = true;
      setSummary("—", "—");
      setStep(1);
    };

    $$("[data-go-pos]").forEach((a) => {
      a.href = posUrl;
      a.addEventListener("click", (e) => {
        e.preventDefault();
        void goToPosWithSso();
      });
    });

    $$("[data-toggle-password]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = btn.closest(".field-password")?.querySelector("input");
        if (!input) return;
        const show = input.type === "password";
        input.type = show ? "text" : "password";
        btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
        btn.classList.toggle("is-visible", show);
      });
    });

    const isFieldValid = (el) => el.checkValidity();

    const registerForm = $("[data-register-form]");
    const registerSubmit = $("[data-register-submit]");
    const registerError = $("[data-register-error]");
    const registerHint = $("[data-register-hint]");

    const syncRegisterSubmit = () => {
      const fields = [...registerForm.querySelectorAll("input")];
      const valid = fields.every(isFieldValid);
      registerSubmit.disabled = !valid;
      registerHint.hidden = valid;
    };
    registerForm.addEventListener("input", () => {
      syncRegisterSubmit();
      // Refleja tienda/email en el resumen mientras se escribe.
      const fd = new FormData(registerForm);
      const name = String(fd.get("storeName") ?? "").trim();
      const email = String(fd.get("adminEmail") ?? "").trim();
      setSummary(name || "—", email || "—");
    });

    const loginForm = $("[data-login-form]");
    const loginSubmit = $("[data-login-submit]");
    const loginError = $("[data-login-error]");

    // -------- Modal de planes --------

    const plansModal = $("[data-plans-modal]");
    let lastPlansFocus = null;

    const openPlans = () => {
      lastPlansFocus = document.activeElement;
      plansModal.hidden = false;
      document.body.style.overflow = "hidden";
      $("[data-plans-close]")?.focus();
    };
    const closePlans = () => {
      plansModal.hidden = true;
      document.body.style.overflow = "";
      if (lastPlansFocus instanceof HTMLElement) lastPlansFocus.focus();
    };

    $$("[data-plans-open]").forEach((btn) => {
      btn.addEventListener("click", openPlans);
    });
    $$("[data-plans-close]").forEach((btn) => {
      btn.addEventListener("click", closePlans);
    });
    $$("[data-plans-select]").forEach((btn) => {
      btn.addEventListener("click", () => {
        closePlans();
        // Si el usuario aún está en el paso 1 sin sesión, el foco queda en
        // "Ver planes"; nada más que hacer — ya está en el checkout del plan.
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !plansModal.hidden) closePlans();
    });

    const syncLoginSubmit = () => {
      const fields = [...loginForm.querySelectorAll("input")];
      loginSubmit.disabled = !fields.every(isFieldValid);
    };
    loginForm.addEventListener("input", syncLoginSubmit);

    document.querySelectorAll("[data-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        hideError(registerError);
        hideError(loginError);
        const isLogin = btn.dataset.toggle === "login";
        registerPanel.hidden = isLogin;
        loginPanel.hidden = !isLogin;
      });
    });

    $$("[data-reset], [data-verify-change-account]").forEach((btn) => {
      btn.addEventListener("click", () => {
        clearSession();
        window.location.reload();
      });
    });

    // -------- Paso 2: confirmar correo --------

    const syncVerifySubmit = () => {
      verifySubmit.disabled = !verifyInput.checkValidity();
      verifyHint.hidden = verifyInput.checkValidity();
    };
    verifyInput.addEventListener("input", syncVerifySubmit);

    const sendCode = async () => {
      const session = readSession();
      if (!session?.email) return;
      hideError(verifyError);
      const res = await fetch(`${apiUrl}/auth/resend-verification`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: session.email }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.message ?? "No se pudo enviar el código. Intentalo de nuevo.");
      }
    };

    $$("[data-resend-code]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = "Enviando...";
        try {
          await sendCode();
          showError(verifyError, "Código reenviado — revisá tu bandeja de entrada.");
        } catch (err) {
          showError(verifyError, err.message ?? "No se pudo enviar el código.");
        }
        btn.disabled = false;
        btn.textContent = original;
      });
    });

    verifyForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideError(verifyError);
      verifySubmit.disabled = true;
      verifySubmit.textContent = "Verificando...";

      const session = readSession();
      if (!session?.email) {
        resetToStart();
        return;
      }

      try {
        const res = await fetch(`${apiUrl}/auth/verify-email`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            identifier: session.email,
            code: verifyInput.value.trim(),
          }),
        });
        const data = await res.json().catch(() => null);

        if (!res.ok) {
          throw new Error(data?.message ?? "Código incorrecto. Intentalo de nuevo.");
        }

        // El backend rota los tokens al verificar → actualizar la sesión local.
        const updated = { ...(readSession() ?? {}), emailVerified: true };
        if (data.accessToken) updated.accessToken = data.accessToken;
        if (data.refreshToken) updated.refreshToken = data.refreshToken;
        accessToken = updated.accessToken;
        saveSession(updated);

        await enterPay(updated.storeName ?? null, updated.email ?? session.email);
      } catch (err) {
        showError(verifyError, err.message ?? "No se pudo verificar el código.");
        verifySubmit.disabled = false;
        verifySubmit.textContent = "Verificar correo";
      }
    });

    registerForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideError(registerError);
      registerSubmit.disabled = true;
      registerSubmit.textContent = "Creando cuenta...";

      const fd = new FormData(registerForm);
      const payload = {
        storeName: fd.get("storeName"),
        adminName: fd.get("adminName"),
        adminEmail: fd.get("adminEmail"),
        adminPassword: fd.get("adminPassword"),
      };

      try {
        const res = await fetch(`${apiUrl}/auth/register-store`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => null);

        if (!res.ok) {
          const msg = data?.message ?? "No se pudo crear la cuenta. Intentalo de nuevo.";
          if (res.status === 409) {
            // La tienda/email ya existe → pasamos a login con el email precargado.
            showError(registerError, "Ya existe una tienda con ese email. Ingresá para continuar.");
            loginForm.querySelector('input[name="email"]').value = payload.adminEmail;
            loginPanel.hidden = false;
            registerPanel.hidden = true;
            hideError(registerError);
            hideError(loginError);
          } else {
            showError(registerError, msg);
          }
          registerSubmit.disabled = false;
          registerSubmit.textContent = "Crear cuenta y continuar";
          return;
        }

        const emailVerified = data.user?.email_verified ?? false;
        saveSession({
          accessToken: data.accessToken,
          refreshToken: data.refreshToken,
          storeName: data.store?.name ?? payload.storeName,
          email: data.user?.email ?? payload.adminEmail,
          emailVerified,
        });
        accessToken = data.accessToken;
        afterAuth(
          data.store?.name ?? payload.storeName,
          data.user?.email ?? payload.adminEmail,
          emailVerified,
          false, // el backend ya envió el código al registrar la tienda
        );
      } catch (err) {
        showError(registerError, err.message ?? "No se pudo crear la cuenta. Intentalo de nuevo.");
        registerSubmit.disabled = false;
        registerSubmit.textContent = "Crear cuenta y continuar";
      }
    });

    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideError(loginError);
      loginSubmit.disabled = true;
      loginSubmit.textContent = "Ingresando...";

      const fd = new FormData(loginForm);
      const payload = { email: fd.get("email"), password: fd.get("password") };

      try {
        const res = await fetch(`${apiUrl}/auth/login`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => null);

        if (!res.ok) {
          showError(loginError, data?.message ?? "Email o contraseña incorrectos.");
          loginSubmit.disabled = false;
          loginSubmit.textContent = "Iniciar sesión y continuar";
          return;
        }

        const emailVerified = data.user?.email_verified ?? false;
        saveSession({
          accessToken: data.accessToken,
          refreshToken: data.refreshToken,
          storeName: data.store?.name ?? null,
          email: data.user?.email ?? payload.email,
          emailVerified,
        });
        accessToken = data.accessToken;
        afterAuth(
          data.store?.name ?? null,
          data.user?.email ?? payload.email,
          emailVerified,
          true, // el login no envía código → lo enviamos nosotros
        );
      } catch (err) {
        showError(loginError, err.message ?? "No se pudo iniciar sesión.");
        loginSubmit.disabled = false;
        loginSubmit.textContent = "Iniciar sesión y continuar";
      }
    });

    // Tras registrarse/loguearse: si el email ya está verificado → pago;
    // si no → paso de confirmación de correo (con envío de código si hace falta).
    async function afterAuth(storeName, email, emailVerified, sendCodeOnEnter) {
      setSummary(storeName, email);
      if (!emailVerified) {
        await enterVerify(email, sendCodeOnEnter);
        return;
      }
      await enterPay(storeName, email);
    }

    async function enterVerify(email, autoSend) {
      verifyEmailLabel.textContent = email;
      hideError(verifyError);
      verifyForm.reset();
      verifyInput.value = "";
      syncVerifySubmit();
      setStep(2);

      if (autoSend) {
        try {
          await sendCode();
        } catch (err) {
          showError(verifyError, err.message ?? "No se pudo enviar el código. Intentalo de nuevo.");
        }
      }
    }

    async function enterPay(storeName, email) {
      hideError(payError);
      setSummary(storeName, email);
      if (storeName) {
        $("[data-success-store]").textContent = storeName;
        paySuccess.hidden = false;
      }
      setStep(3);
      if (payButtons.childElementCount === 0) {
        await mountPaypal();
        saveSession({ ...(readSession() ?? {}), paypalMounted: true });
      }
    }

    async function mountPaypal() {
      payButtons.innerHTML = "";
      payLoading.hidden = false;

      if (!paypalClientId) {
        const btn = document.createElement("a");
        btn.className = "btn-primary checkout__submit";
        btn.href = posUrl;
        btn.textContent = "Ir a mi tienda";
        payButtons.appendChild(btn);
        payLoading.hidden = true;
        return;
      }

      try {
        const cloudRes = await fetch(`${apiUrl}/subscriptions/cloud`, {
          method: "POST",
          headers: { Authorization: `Bearer ${accessToken}` },
        });
        if (!cloudRes.ok) {
          if (cloudRes.status === 401 || cloudRes.status === 403) {
            resetToStart();
            return;
          }
          throw new Error(
            (await cloudRes.json().catch(() => null))?.message ?? "No se pudo iniciar el trial.",
          );
        }

        const checkoutRes = await fetch(`${apiUrl}/subscriptions/checkout`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${accessToken}`,
          },
          body: JSON.stringify({
            return_url: window.location.href,
            cancel_url: window.location.href,
          }),
        });
        const checkoutData = await checkoutRes.json().catch(() => null);

        if (!checkoutRes.ok) {
          if (checkoutRes.status === 401 || checkoutRes.status === 403) {
            resetToStart();
            return;
          }
          throw new Error(checkoutData?.message ?? "No se pudo iniciar el pago.");
        }

        const paypalSubscriptionId = checkoutData.paypalSubscriptionId;

        const sdkUrl = `https://${paypalSandbox ? "www.sandbox.paypal.com" : "www.paypal.com"}/sdk/js?client-id=${encodeURIComponent(paypalClientId)}&intent=subscription&vault=true&currency=USD`;

        await loadScript(sdkUrl);

        if (!window.paypal?.Buttons) {
          throw new Error("No se pudo cargar el método de pago. Intentalo de nuevo.");
        }

        const render = (fundingSource, targetId) => {
          if (!window.paypal?.Buttons) return Promise.resolve();
          return window.paypal
            .Buttons({
              fundingSource,
              style: { label: "subscribe", shape: "rect", layout: "vertical", height: 45 },
              createSubscription: () => Promise.resolve(paypalSubscriptionId),
              onApprove: async (data) => {
                const subscriptionID = data?.subscriptionID ?? paypalSubscriptionId;
                await activate(subscriptionID);
              },
              onError: () => {
                showError(payError, "Ocurrió un error con PayPal. Intentalo de nuevo.");
              },
              onCancel: () => {
              },
            })
            .render(targetId);
        };

        const cardRender = render("card", "#paypal-buttons");

        const sep = document.createElement("p");
        sep.className = "pay__sep";
        sep.textContent = "o";
        payButtons.appendChild(sep);

        const paypalContainer = document.createElement("div");
        paypalContainer.id = "paypal-buttons-account";
        payButtons.appendChild(paypalContainer);

        const paypalRender = render("paypal", "#paypal-buttons-account");

        // Los botones recién existen cuando .render() resolvió.
        await Promise.all([cardRender, paypalRender]);
        payLoading.hidden = true;
      } catch (err) {
        payLoading.hidden = true;
        showError(payError, err.message);
      }
    }

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[src="${src}"]`);
        if (existing) return resolve();

        const s = document.createElement("script");
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = () => reject(new Error("No se pudo cargar PayPal."));
        document.head.appendChild(s);
      });
    }

    async function activate(subscriptionID) {
      hideError(payError);

      try {
        const res = await fetch(`${apiUrl}/subscriptions/activate`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${accessToken}`,
          },
          body: JSON.stringify({ paypal_subscription_id: subscriptionID }),
        });
        const data = await res.json().catch(() => null);

        if (!res.ok) {
          throw new Error(
            data?.message ?? "El pago se acreditó, pero hubo un problema al activar. Nuestro equipo lo revisa.",
          );
        }

        saveSession({ ...(readSession() ?? {}), paid: true });
        setStep(4);
      } catch (err) {
        showError(payError, err.message);
      }
    }

    async function resumeFlow() {
      const session = readSession();
      if (!session?.accessToken) {
        setStep(1);
        return;
      }
      accessToken = session.accessToken;

      try {
        const res = await fetch(`${apiUrl}/subscriptions/mine`, {
          headers: { Authorization: `Bearer ${accessToken}` },
        });
        const data = await res.json().catch(() => null);

        // Solo una suscripción Cloud real cuenta como activa: el backend
        // devuelve { mode: "self_hosted", status: "active" } como default
        // cuando la tienda no tiene fila de suscripción.
        if (res.ok && data?.status === "active" && data?.mode === "cloud") {
          saveSession({ ...session, paid: true, emailVerified: true });
          setSummary(session.storeName, session.email);
          setStep(4);
          return;
        }
        if (res.ok) {
          // Trial o similar: la sesión es válida → verificar email si falta, si no → pago.
          setSummary(session.storeName, session.email);
          if (session.emailVerified) {
            await enterPay(session.storeName, session.email);
          } else {
            await enterVerify(session.email, false);
          }
          return;
        }
        // Token inválido/vencido (401/403) o error del servidor → empezar desde cero.
        resetToStart();
      } catch {
        // No se pudo verificar la sesión → checkout limpio.
        resetToStart();
      }
    }

    void resumeFlow();

    syncRegisterSubmit();
    syncLoginSubmit();
  })();
</script>

