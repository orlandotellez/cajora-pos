---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const CONFIG_URL =
  import.meta.env.PUBLIC_CONFIG_API_URL ??
  'https://pub-17156739f1d5412cb62a579bb0ccbc35.r2.dev/config-api.json';

interface DownloadConfig {
  app_version?: string;
  apk_url?: string;
  exe_url?: string;
  deb_url?: string;
  app_image_url?: string;
}

let buildSnapshot: Partial<DownloadConfig> = {};
try {
  const res = await fetch(CONFIG_URL, { signal: AbortSignal.timeout(8000) });
  if (res.ok) buildSnapshot = await res.json();
} catch {}
const SNAPSHOT_JSON = JSON.stringify(buildSnapshot).replace(/</g, '\\u003c');
---

<Layout
  title="Descargas · CajoraPOS"
  description="Descargá CajoraPOS para Android, Windows y Linux. La versión self-hosted es gratuita para siempre."
>
  <main class="downloads container-narrow">
    <h1 class="downloads__title">Descargá CajoraPOS</h1>
    <p class="downloads__lead">
      Disponible para Android, Windows y Linux. La versión self-hosted es gratuita para siempre.
    </p>

    <div class="downloads__grid">
      <article class="download-card" data-card>
        <div class="download-card__icon">
          <Icon name="android" size={28} />
        </div>
        <h2 class="download-card__name">Android</h2>
        <p class="download-card__meta" data-meta>Cargando…</p>
        <a class="btn-primary download-card__btn" data-dl="apk_url" data-file="APK universal" hidden>
          <Icon name="download" size={16} />
          Descargar APK
        </a>
        <button class="btn-primary download-card__btn" data-soon disabled>Próximamente</button>
        <p class="download-card__note">
          En Android permití la instalación desde orígenes desconocidos (Configuración → Seguridad).
        </p>
      </article>

      <article class="download-card" data-card>
        <div class="download-card__icon">
          <Icon name="windows" size={28} />
        </div>
        <h2 class="download-card__name">Windows</h2>
        <p class="download-card__meta" data-meta>Cargando…</p>
        <a class="btn-primary download-card__btn" data-dl="exe_url" data-file=".exe" hidden>
          <Icon name="download" size={16} />
          Descargar .exe
        </a>
        <button class="btn-primary download-card__btn" data-soon disabled>Próximamente</button>
      </article>

      <article class="download-card" data-card>
        <div class="download-card__icon">
          <Icon name="linux" size={28} />
        </div>
        <h2 class="download-card__name">Linux</h2>
        <p class="download-card__meta" data-meta>Cargando…</p>
        <div class="download-card__actions" data-actions hidden>
          <a class="btn-primary download-card__btn" data-dl="deb_url" data-file=".deb" hidden>
            <Icon name="download" size={16} />
            .deb
          </a>
          <a class="btn-secondary download-card__btn" data-dl="app_image_url" data-file=".AppImage" hidden>
            <Icon name="download" size={16} />
            .AppImage
          </a>
        </div>
        <button class="btn-primary download-card__btn" data-soon disabled>Próximamente</button>
      </article>
    </div>

    <section class="downloads__selfhosted">
      <h2 class="downloads__selfhosted-title">¿Preferís tener todo en tu propio servidor?</h2>
      <p class="downloads__selfhosted-text">
        La versión self-hosted es gratuita para siempre: instalala en tu infraestructura y tus datos son 100% tuyos.
      </p>
      <a
        href="https://github.com/orlandotellez/cajora-pos"
        target="_blank"
        rel="noopener"
        class="btn-secondary downloads__selfhosted-btn"
      >
        Ver instalación en GitHub
      </a>
    </section>
  </main>
</Layout>

<script>
  const CONFIG_URL =
    import.meta.env.PUBLIC_CONFIG_API_URL ??
    'https://pub-17156739f1d5412cb62a579bb0ccbc35.r2.dev/config-api.json';

  interface DownloadConfig {
    app_version?: string;
    apk_url?: string;
    exe_url?: string;
    deb_url?: string;
    app_image_url?: string;
  }

  function markUnavailable(): void {
    document.querySelectorAll<HTMLElement>('[data-meta]').forEach((meta) => {
      meta.textContent = '—';
    });
  }

  function readSnapshot(): DownloadConfig | null {
    const el = document.getElementById('downloads-config');
    if (!el?.textContent) return null;
    try {
      return JSON.parse(el.textContent) as DownloadConfig;
    } catch {
      return null;
    }
  }

  function applyConfig(cfg: DownloadConfig): void {
    const version = cfg.app_version ? `v${cfg.app_version}` : '';

    document.querySelectorAll<HTMLAnchorElement>('[data-dl]').forEach((link) => {
      const url = cfg[(link.dataset.dl ?? '') as keyof DownloadConfig];
      if (!url) return;
      link.href = url;
      link.hidden = false;
    });

    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      const links = [...card.querySelectorAll<HTMLAnchorElement>('[data-dl]:not([hidden])')];
      if (links.length === 0) {
        const meta = card.querySelector<HTMLElement>('[data-meta]');
        if (meta) meta.textContent = '—';
        return;
      }

      const soon = card.querySelector<HTMLElement>('[data-soon]');
      if (soon) soon.hidden = true;

      const actions = card.querySelector<HTMLElement>('[data-actions]');
      if (actions) actions.hidden = false;

      const files = [...new Set(links.map((l) => l.dataset.file ?? '').filter(Boolean))];
      const meta = card.querySelector<HTMLElement>('[data-meta]');
      if (meta) meta.textContent = [files.join(' / '), version].filter(Boolean).join(' · ');
    });
  }

  async function initDownloads(): Promise<void> {
    let cfg = readSnapshot();

    try {
      const res = await fetch(CONFIG_URL, { cache: 'no-store' });
      if (res.ok) cfg = { ...cfg, ...((await res.json()) as DownloadConfig) };
    } catch {}

    if (!cfg || Object.keys(cfg).length === 0) {
      markUnavailable();
      return;
    }
    applyConfig(cfg);
  }

  initDownloads();
</script>

<script type="application/json" id="downloads-config" set:html={SNAPSHOT_JSON} />

<style>
  .downloads {
    /* padding superior: header fijo (64px) + aire */
    padding-top: calc(64px + 4rem);
    padding-bottom: 5rem;
  }

  .downloads__title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .downloads__lead {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .downloads__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .download-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .download-card__name {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .download-card__meta {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  /* btn/btn-secondary definen display propio: sin esto, [hidden] no oculta */
  .download-card [hidden] {
    display: none !important;
  }

  .download-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .download-card__btn {
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    width: 100%;
    border: 0;
    cursor: pointer;
  }

  .download-card__btn:disabled {
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border);
    cursor: not-allowed;
  }

  .download-card__btn:disabled:hover {
    opacity: 1;
  }

  .download-card__note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .downloads__selfhosted {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .downloads__selfhosted-title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .downloads__selfhosted-text {
    color: var(--text-muted);
    max-width: 36rem;
    margin: 0 auto 1.5rem;
  }

  .downloads__selfhosted-btn {
    padding: 0.75rem 1.5rem;
  }

  @media (min-width: 900px) {
    .downloads__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
