---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CajoraPOS · Tu punto de venta inteligente',
  description = 'Gestiona tus ventas, inventario y reportes con una herramienta diseñada para la eficiencia. Disponible para Web, Desktop y Android.',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040609" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema antes del primer paint para evitar parpadeo (FOUC)
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
        var theme = stored || (prefersLight ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#F6F8FB' : '#040609');
      })();
    </script>
  </head>
  <body
    class="site-body"
    data-base-url={import.meta.env.BASE_URL}
    data-pos-url={import.meta.env.PUBLIC_POS_URL}
  >
    <Header />
    <slot />
    <Footer/>
    <script is:inline>
      // Aplica el estado de sesión a los CTAs antes del primer paint.
      // Evita que al recargar parpadeen "Registrar tienda" / "Iniciar sesión"
      // cuando ya hay una sesión activa.
      (function () {
        var readSession = function () {
          try { return JSON.parse(localStorage.getItem('caja_checkout')); } catch (e) { return null; }
        };
        var base = document.body.getAttribute('data-base-url') || '/';
        var posUrl = document.body.getAttribute('data-pos-url') || '';
        var checkoutUrl = base + 'checkout';
        var loginUrl = base + 'login';
        var perfilUrl = base + 'perfil';
        var pricingUrl = base + '#precios';
        var descargarUrl = base + 'descargar';

        var setCtaText = function (el, text) {
          var textNode = null;
          for (var i = 0; i < el.childNodes.length; i++) {
            var n = el.childNodes[i];
            if (n.nodeType === Node.TEXT_NODE && n.textContent.trim()) { textNode = n; break; }
          }
          if (textNode) textNode.textContent = text;
          else el.textContent = text;
        };

        var applyAuth = function (paid, hasSession) {
          document.querySelectorAll('[data-auth-paid]').forEach(function (el) {
            var tag = el.querySelector('[data-auth-tag]');
            if (tag) tag.textContent = paid ? 'Tu plan actual' : 'Recomendado';
          });
          document.querySelectorAll('[data-auth-cta="secondary"]').forEach(function (el) {
            el.hidden = false;
            if (hasSession) {
              el.setAttribute('href', perfilUrl);
              setCtaText(el, 'Mi perfil');
            } else {
              el.setAttribute('href', loginUrl);
              setCtaText(el, 'Iniciar sesión');
            }
          });
          document.querySelectorAll('[data-auth-cta="primary"]').forEach(function (el) {
            el.hidden = false;
            var storeIcon = el.querySelector('[data-cta-icon="store"]');
            var downloadIcon = el.querySelector('[data-cta-icon="download"]');
            if (storeIcon) storeIcon.style.display = hasSession ? 'none' : '';
            if (downloadIcon) downloadIcon.style.display = hasSession ? '' : 'none';
            if (hasSession) {
              el.setAttribute('href', descargarUrl);
              setCtaText(el, 'Descargar aplicación');
            } else {
              el.setAttribute('href', pricingUrl);
              setCtaText(el, 'Registrar tienda');
            }
          });
          document.querySelectorAll('[data-auth-cta="content"]').forEach(function (el) {
            if (paid) {
              el.setAttribute('href', posUrl);
              setCtaText(el, 'Ir a mi tienda');
            } else if (hasSession) {
              el.setAttribute('href', checkoutUrl);
              setCtaText(el, 'Continuar pago');
            } else {
              el.setAttribute('href', checkoutUrl);
            }
          });
        };

        window.__applyAuth = applyAuth;

        var session = readSession();
        var isNativeApp = '__TAURI__' in window;
        var hasToken = isNativeApp ? !!(session && session.accessToken) : !!(session && session.email);
        applyAuth(!!(session && session.paid), hasToken);
      })();
    </script>
    <script>
      import { goToPosWithSso } from "../lib/sso";
      (() => {
        const isNativeApp = '__TAURI__' in window;
        const readSession = () => {
          try {
            return JSON.parse(localStorage.getItem('caja_checkout'));
          } catch {
            return null;
          }
        };
        const saveSession = (data) => localStorage.setItem('caja_checkout', JSON.stringify(data));
        const posUrl = import.meta.env.PUBLIC_POS_URL;
        const apiUrl = import.meta.env.PUBLIC_API_URL;

        // La lógica de pintado de CTAs vive en window.__applyAuth, definida por el
        // script inline temprano del <body> para aplicarse antes del primer paint.
        const applyAuth = (paid: boolean, hasSession: boolean): void => {
          (window as unknown as { __applyAuth?: (p: boolean, h: boolean) => void }).__applyAuth?.(paid, hasSession);
        };

        const session = readSession();
        const hasToken = isNativeApp ? !!session?.accessToken : !!session?.email;
        applyAuth(!!session?.paid, hasToken);

        document.querySelectorAll('[data-auth-cta="content"]').forEach((el) => {
          el.addEventListener('click', (e) => {
            if (el.getAttribute('href') === posUrl) {
              e.preventDefault();
              void goToPosWithSso();
            }
          });
        });

        const fetchHeaders = {};
        const fetchOpts = {};
        if (isNativeApp && session?.accessToken) {
          fetchHeaders['Authorization'] = `Bearer ${session.accessToken}`;
        } else if (!isNativeApp) {
          fetchOpts.credentials = 'include';
        }

        async function fetchWithRefresh(url, opts) {
          const first = await fetch(url, opts);
          if (isNativeApp || first.status !== 401) return first;
          try {
            const refreshRes = await fetch(`${apiUrl}/auth/refresh`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
            });
            if (refreshRes.ok) return fetch(url, opts);
          } catch {}
          return first;
        }

        const fetcher = isNativeApp
          ? (url, opts) => fetch(url, opts)
          : (url, opts) => fetchWithRefresh(url, opts);

        fetcher(`${apiUrl}/subscriptions/mine`, {
          ...fetchOpts,
          headers: fetchHeaders,
        })
          .then((r) => {
            if (r.status === 401 || r.status === 403) {
              if (!isNativeApp) {
                localStorage.removeItem('caja_checkout');
              }
              applyAuth(false, false);
              return null;
            }
            return r.json().catch(() => null);
          })
          .then((data) => {
            if (!data) return;
            const paid = data?.status === 'active' && data?.mode === 'cloud';
            const current = readSession();
            if (current && !!current.paid !== paid) {
              saveSession({ ...current, paid });
            }
            applyAuth(paid, true);
          })
          .catch(() => {
            applyAuth(!!session?.paid, hasToken);
          });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --radius: 5px;
    --radius-sm: 3px;
    --radius-lg: 10px;

    --bg: #040609;
    --surface: #090b0f;
    --surface-2: #0e1117;
    --border: #27272a;
    --border-strong: #3f3f46;

    --text: #fafafa;
    --text-muted: #a1a1aa;

    --green: #10b981;

    --glass: rgba(4, 6, 9, 0.75);
    --glow: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    --shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    --hover-border: #52525b;

    --max: 1280px;
    --max-narrow: 1024px;
    --max-read: 768px;

    --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html[data-theme='light'] {
    --bg: #F6F8FB;
    --surface: #FFFFFF;
    --surface-2: #EEF2F7;
    --border: #e4e4e7;
    --border-strong: #d4d4d8;

    --text: #18181b;
    --text-muted: #71717a;

    --green: #10b981;

    --glass: rgba(246, 248, 251, 0.85);
    --glow: radial-gradient(
      circle,
      rgba(26, 34, 48, 0.07) 0%,
      rgba(246, 248, 251, 0) 70%
    );
    --shadow: 0 25px 50px -12px rgba(26, 34, 48, 0.18);
    --hover-border: #a1a1aa;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.5;
  }

  /* Estilo del body del sitio */
  .site-body {
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-x: hidden;
  }
  .site-body ::selection {
    background: #ffffff;
    color: #000000;
  }

  .site-main {
    flex-grow: 1;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  ul {
    list-style: none;
  }

  h1, h2, h3, h4 {
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  [hidden] {
    display: none !important;
  }

  section[id] {
    scroll-margin-top: 80px;
  }

  /* Glass nav effect for header */
  .glass-nav {
    background: var(--glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Card border glow effect */
  .card-border-glow {
    position: relative;
  }
  .card-border-glow::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.02));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Perspective grid background */
  .perspective-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.4;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    /* Visible atrás del título/subtítulo (arriba) y se desvanece hacia abajo */
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 90%);
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 90%);
  }

  /* Buttons (shared atomic styles) */
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    font-weight: 600;
    transition: opacity 150ms ease, background-color 150ms ease;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    background: var(--surface);
  }

  /* Container helpers */
  .container {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container-narrow {
    width: 100%;
    max-width: var(--max-narrow);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container-read {
    width: 100%;
    max-width: var(--max-read);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
