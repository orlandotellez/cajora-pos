---
const base = import.meta.env.BASE_URL;
---

<section class="bottom-cta" id="descargas">
  <div class="bottom-cta__container">
    <div class="bottom-cta__card">
      <div class="bottom-cta__blob" aria-hidden="true"></div>
      <h2 class="bottom-cta__title">¿Listo para modernizar tu negocio?</h2>
      <p class="bottom-cta__lead">
        Únete a los comercios que ya optimizan sus operaciones con Caja. Descarga la versión gratuita o activá tu suscripción hoy mismo.
      </p>
      <div class="bottom-cta__buttons">
        <a href={base + 'checkout'} class="bottom-cta__btn bottom-cta__btn--solid" data-auth-cta="content">Ir a mi tienda</a>
        <a href={base + 'descargar'} class="bottom-cta__btn bottom-cta__btn--ghost">Ver tutorial de instalación</a>
      </div>
    </div>
  </div>
</section>

<style>
  .bottom-cta {
    padding: 5rem 0;
  }

  .bottom-cta__container {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .bottom-cta__card {
    position: relative;
    background: #18181b;
    color: #fafafa;
    border: 1px solid #27272a;
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .bottom-cta__blob {
    position: absolute;
    right: -4rem;
    bottom: -4rem;
    width: 16rem;
    height: 16rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    filter: blur(48px);
    opacity: 0.6;
    pointer-events: none;
  }

  .bottom-cta__title {
    position: relative;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
    max-width: 34rem;
    margin: 0 auto;
  }

  .bottom-cta__lead {
    position: relative;
    font-size: 1.0625rem;
    color: #a1a1aa;
    max-width: 36rem;
    margin: 1rem auto 0;
    line-height: 1.7;
  }

  .bottom-cta__buttons {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .bottom-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 150ms ease, background-color 150ms ease;
  }

  .bottom-cta__btn--solid {
    background: #ffffff;
    color: #18181b;
    border: none;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  }
  .bottom-cta__btn--solid:hover {
    background: #e4e4e7;
  }

  .bottom-cta__btn--ghost {
    border: 1px solid #52525b;
    background: transparent;
    color: #fafafa;
  }
  .bottom-cta__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  @media (min-width: 640px) {
    .bottom-cta__buttons {
      flex-direction: row;
    }
    .bottom-cta__btn {
      width: auto;
    }
  }
</style>
