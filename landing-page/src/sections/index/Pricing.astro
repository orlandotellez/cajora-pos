---
const selfHosted = [
  'Instalación en servidor propio',
  'Productos y ventas ilimitadas',
  'Datos 100% privados',
  'Comunidad de soporte',
];

const cloud = [
  'Respaldos automáticos diarios',
  'Soporte técnico prioritario',
  'Configuración asistida',
  'Acceso remoto desde cualquier lugar',
  'Actualizaciones automáticas',
];

const base = import.meta.env.BASE_URL;
---

<section class="pricing" id="precios">
  <div class="pricing__container">
    <div class="pricing__heading">
      <h2 class="pricing__title">Planes flexibles</h2>
      <p class="pricing__subtitle">Elige la opción que mejor se adapte a tu infraestructura.</p>
    </div>

    <div class="pricing__grid">
      <!-- Plan 1: Self-hosted -->
      <article class="plan">
        <div class="plan__head">
          <h3 class="plan__title">Gratis · Self-hosted</h3>
          <div class="plan__price">
            <span class="plan__amount">$0</span>
            <span class="plan__period">/siempre</span>
          </div>
        </div>
        <p class="plan__desc">Para emprendedores técnicos y desarrolladores que desean autonomía total.</p>
        <ul class="plan__list">
          {selfHosted.map((item) => (
            <li class="plan__item">
              <span class="plan__check">
                <svg class="plan__check-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a href={base + 'descargar'} class="plan__cta plan__cta--ghost">Descargar Instalador</a>
      </article>

      <!-- Plan 2: Cloud (Featured) -->
      <article class="plan plan--featured" id="plan-cloud" data-auth-paid>
        <span class="plan__tag" data-auth-tag>Recomendado</span>
        <div class="plan__head">
          <h3 class="plan__title">Suscripción · Cloud</h3>
          <div class="plan__price">
            <span class="plan__amount">$15.99</span>
            <span class="plan__period">/mes</span>
          </div>
        </div>
        <p class="plan__desc">Todo gestionado y protegido en la nube, con soporte dedicado continuo.</p>
        <ul class="plan__list">
          {cloud.map((item) => (
            <li class="plan__item">
              <span class="plan__check">
                <svg class="plan__check-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a href={base + 'checkout'} class="plan__cta plan__cta--solid" data-auth-cta="content">Comenzar ahora</a>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 6rem 0;
    border-top: 1px solid rgba(39, 39, 42, 0.8);
    background: var(--surface);
  }

  .pricing__container {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pricing__heading {
    text-align: center;
    margin-bottom: 4rem;
  }

  .pricing__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .pricing__subtitle {
    font-size: 1.0625rem;
    color: var(--text-muted);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    padding: 2.25rem;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .plan:hover {
    border-color: var(--hover-border);
    transform: translateY(-2px);
  }

  .plan--featured {
    border-width: 2px;
    border-color: var(--text);
    background: var(--surface-2);
    box-shadow: 0 25px 60px -15px rgba(255, 255, 255, 0.25);
  }

  .plan__tag {
    position: absolute;
    top: -0.8rem;
    right: 1.75rem;
    padding: 0.3rem 0.9rem;
    background: var(--tag-bg, #18181b);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 800;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .plan__head {
    margin-bottom: 1rem;
  }

  .plan__title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .plan--featured .plan__title {
    color: var(--text);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .plan__amount {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .plan__period {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .plan__desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .plan__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2.25rem;
    flex-grow: 1;
  }

  .plan__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .plan--featured .plan__item {
    color: var(--text);
  }

  .plan__check {
    display: inline-flex;
    color: var(--text-muted);
    opacity: 0.55;
    flex-shrink: 0;
  }
  .plan--featured .plan__check {
    color: #10b981;
    opacity: 1;
  }

  .plan__check-icon {
    width: 1rem;
    height: 1rem;
  }

  .plan__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1.5rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    transition: background-color 150ms ease, border-color 150ms ease, opacity 150ms ease;
    text-align: center;
  }

  .plan__cta--ghost {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--text);
  }
  .plan__cta--ghost:hover {
    border-color: var(--hover-border);
    background: var(--surface-2);
  }

  .plan__cta--solid {
    background: #ffffff;
    color: var(--bg);
    box-shadow: 0 10px 15px -3px rgba(255, 255, 255, 0.1);
  }
  .plan__cta--solid:hover {
    background: #e4e4e7;
    opacity: 0.88;
  }

  /* En modo claro el CTA destacado invierte para mantener contraste */
  html[data-theme='light'] .plan__cta--solid {
    background: var(--text);
    color: #ffffff;
    box-shadow: 0 10px 15px -3px rgba(24, 24, 27, 0.2);
  }
  html[data-theme='light'] .plan__cta--solid:hover {
    background: #27272a;
    opacity: 0.88;
  }

  @media (min-width: 768px) {
    .pricing__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
</style>
