---
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="inicio">
  <!-- Ambientes: cuadrícula + glow -->
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__inner">
    <!-- Main Headline -->
    <h1 class="hero__title">
      Tu punto de venta, tus datos, <br class="hero__br">tu negocio
    </h1>

    <!-- Subtitle -->
    <p class="hero__lead">
      Vendé, controlá tu inventario y crecé con una herramienta que funciona para vos. Disponible gratis en tu servidor o en la nube.
    </p>

    <!-- CTA Buttons -->
    <div class="hero__ctas">
      <a class="hero__btn hero__btn--primary" data-auth-cta="primary" >
        <svg class="hero__btn__icon" data-cta-icon="store" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"></path>
          <path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"></path>
          <path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"></path>
        </svg>
        <svg class="hero__btn__icon" data-cta-icon="download" style="display: none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Registrar tienda
      </a>
      <a class="hero__btn hero__btn--secondary" href="https://app.cajorapos.com?demo=1" target="_blank" rel="noopener">
        <svg class="hero__btn__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        Ver demo en vivo
      </a>
    </div>

    <!-- POS Device Mockup -->
    <div class="hero__mockup" aria-label="Vista previa del sistema">
      <div class="mockup__halo" aria-hidden="true"></div>

      <div class="mockup-frame">
        <div class="mockup-bar">
          <span class="mockup-bar__url">app.cajorapos.com/pos</span>
        </div>
        <div class="mockup-screen">
          <img
            class="mockup__img"
            src={base + '1.webp'}
            alt="CajoraPOS Sistema Punto de Venta Escritorio"
            width="1755"
            height="896"
          />
          <div class="mockup-screen__sheen" aria-hidden="true"></div>
          <div class="mockup-screen__base" aria-hidden="true"></div>
        </div>
      </div>

      <div class="mockup-base"></div>
      <div class="mockup-foot"></div>

      <!-- Floating phone mockup -->
      <div class="mockup-phone" aria-hidden="true">
        <div class="phone-frame">
          <div class="phone-screen">
            <div class="phone-screen__status">
              <span>9:41</span>
              <span class="phone-screen__notch"></span>
            </div>
            <img
              class="phone-screen__img"
              src={base + '1.webp'}
              alt=""
              loading="lazy"
              width="1755"
              height="896"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 7rem 1.5rem 5rem;
    overflow: hidden;
  }

  /* --- Ambient grid (cuadrícula) --- */
  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.4;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 90%);
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 90%);
  }

  /* --- Ambient glow --- */
  .hero__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 350px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(63, 63, 70, 0.2), rgba(24, 24, 27, 0.1), transparent);
    filter: blur(120px);
  }

  .hero__inner {
    max-width: 72rem; /* 1152px */
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    max-width: 56rem;
    margin: 0 auto;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--text);
  }

  .hero__lead {
    max-width: 32rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__btn[hidden] {
    display: none !important;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 150ms ease, border-color 150ms ease,
      color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .hero__btn:active {
    transform: scale(0.98);
  }

  .hero__btn__icon {
    width: 1rem;
    height: 1rem;
  }

  .hero__btn--primary {
    background: #ffffff;
    color: var(--bg);
    box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.1), 0 10px 10px -5px rgba(255, 255, 255, 0.04);
  }
  .hero__btn--primary:hover {
    background: #e4e4e7;
    box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.2), 0 10px 10px -5px rgba(255, 255, 255, 0.04);
  }

  .hero__btn--secondary {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .hero__btn--secondary:hover {
    background: rgba(39, 39, 42, 0.8);
    border-color: var(--hover-border);
    color: var(--text);
  }
  .hero__btn--secondary svg {
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .hero__btn--secondary:hover svg {
    color: var(--text);
  }

  /* En modo claro el botón primario invierte para mantener contraste */
  html[data-theme='light'] .hero__btn--primary {
    background: var(--text);
    color: #ffffff;
    box-shadow: 0 20px 25px -5px rgba(24, 24, 27, 0.2), 0 10px 10px -5px rgba(24, 24, 27, 0.1);
  }
  html[data-theme='light'] .hero__btn--primary:hover {
    background: #27272a;
    box-shadow: 0 20px 25px -5px rgba(24, 24, 27, 0.35), 0 10px 10px -5px rgba(24, 24, 27, 0.1);
  }

  /* ---------- Mockup ---------- */
  .hero__mockup {
    position: relative;
    max-width: 64rem;
    margin: 3.5rem auto 0;
  }

  .mockup__halo {
    position: absolute;
    inset: -1rem;
    z-index: -1;
    border-radius: 1.5rem;
    background: linear-gradient(to right, rgba(63, 63, 70, 0.15), rgba(255, 255, 255, 0.05), rgba(63, 63, 70, 0.15));
    filter: blur(24px);
    opacity: 0.7;
    pointer-events: none;
  }

  .mockup-frame {
    padding: 0.5rem 0.625rem;
    background: #16161a;
    border: 1px solid rgba(63, 63, 70, 0.8);
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9);
  }

  .mockup-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 1rem;
    background: rgba(24, 24, 27, 0.95);
    border-bottom: 1px solid #27272a;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  .mockup-bar__url {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    color: #d4d4d8;
    background: rgba(4, 6, 9, 0.8);
    border: 1px solid rgba(39, 39, 42, 0.8);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
  }

  .mockup-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0 0 0.75rem 0.75rem;
    overflow: hidden;
    background: #000000;
    border-left: 1px solid #27272a;
    border-right: 1px solid #27272a;
    border-bottom: 1px solid #27272a;
  }

  .mockup__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    -webkit-user-select: none;
    user-select: none;
    display: block;
  }

  .mockup-screen__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top right, transparent, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.06));
    pointer-events: none;
  }

  .mockup-screen__base {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0.75rem;
    background: #000000;
    pointer-events: none;
    z-index: 10;
  }

  .mockup-base {
    width: 8rem;
    height: 1.25rem;
    margin: 0 auto;
    border-radius: 0 0 0.5rem 0.5rem;
    border-left: 1px solid #52525b;
    border-right: 1px solid #52525b;
    border-bottom: 1px solid #52525b;
    background: linear-gradient(to bottom, #3f3f46, #27272a);
  }

  .mockup-foot {
    width: min(20rem, 80%);
    margin: 0.125rem auto 0;
    height: 0.5rem;
    background: linear-gradient(to right, #27272a, #52525b, #27272a);
    border-radius: 999px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
  }

  /* Floating phone */
  .mockup-phone {
    display: none;
    position: absolute;
    left: -2rem;
    bottom: -2.5rem;
    width: 11rem;
    z-index: 20;
  }

  .phone-frame {
    position: relative;
    background: #0c0c0e;
    border: 2px solid rgba(63, 63, 70, 0.8);
    border-radius: 2.5rem;
    padding: 0.5rem;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.8);
  }

  .phone-screen {
    position: relative;
    aspect-ratio: 9 / 19;
    border-radius: 2rem;
    overflow: hidden;
    background: #000000;
    display: flex;
    flex-direction: column;
  }

  .phone-screen__status {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem 0.4rem;
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .phone-screen__notch {
    width: 3.5rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .phone-screen__img {
    flex: 1;
    width: 100%;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 640px) {
    .hero {
      padding-top: 8rem;
    }
    .hero__inner {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .mockup-phone {
      display: block;
    }
  }
</style>
