---
import DeviceCluster from '../../components/DeviceCluster.astro';
---

<section class="hero" id="inicio">
  <!-- Ambientes: cuadrícula + glow -->
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__pattern" aria-hidden="true">
    <svg class="hero__pattern-svg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <pattern id="heroIconPattern" width="180" height="180" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <g transform="translate(16 20) rotate(-12) scale(0.9)">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
              <path d="M13 5v2" />
              <path d="M13 17v2" />
              <path d="M13 11v2" />
            </g>
            <g transform="translate(112 38) rotate(10) scale(0.9)">
              <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
              <path d="M12 22V12" />
              <polyline points="3.29 7 12 12 20.71 7" />
              <path d="m7.5 4.27 9 5.15" />
            </g>
            <g transform="translate(50 110) rotate(-8) scale(0.86)">
              <path d="M3 7V5a2 2 0 0 1 2-2h2" />
              <path d="M17 3h2a2 2 0 0 1 2 2v2" />
              <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
              <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
              <path d="M8 7v10" />
              <path d="M12 7v10" />
              <path d="M17 7v10" />
            </g>
            <g transform="translate(146 146) rotate(16) scale(0.68)">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
              <path d="M13 5v2" />
              <path d="M13 17v2" />
              <path d="M13 11v2" />
            </g>
            <g transform="translate(12 136) rotate(-14) scale(0.7)">
              <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
              <path d="M12 22V12" />
              <polyline points="3.29 7 12 12 20.71 7" />
              <path d="m7.5 4.27 9 5.15" />
            </g>
            <g transform="translate(146 8) rotate(8) scale(0.6)">
              <path d="M3 7V5a2 2 0 0 1 2-2h2" />
              <path d="M17 3h2a2 2 0 0 1 2 2v2" />
              <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
              <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
              <path d="M8 7v10" />
              <path d="M12 7v10" />
              <path d="M17 7v10" />
            </g>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#heroIconPattern)" />
    </svg>
  </div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__inner">
    <!-- Main Headline -->
    <h1 class="hero__title">
      Tu punto de venta, tus datos, <br class="hero__br">tu negocio
    </h1>

    <!-- Subtitle -->
    <p class="hero__lead">
      Vendé, controlá tu inventario y crecé con una herramienta que funciona para vos. Disponible gratis en tu servidor o en la nube.
    </p>

    <!-- CTA Buttons -->
    <div class="hero__ctas">
      <a class="hero__btn hero__btn--primary" data-auth-cta="primary" >
        <svg class="hero__btn__icon" data-cta-icon="store" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"></path>
          <path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"></path>
          <path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"></path>
        </svg>
        <svg class="hero__btn__icon" data-cta-icon="download" style="display: none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Registrar tienda
      </a>
      <a class="hero__btn hero__btn--secondary" href="https://app.cajorapos.com?demo=1" target="_blank" rel="noopener">
        <svg class="hero__btn__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        Ver demo en vivo
      </a>
    </div>

    <!-- POS Device Mockup -->
    <div class="hero__mockup" aria-label="Vista previa del sistema">
      <DeviceCluster desktopAlt="CajoraPOS Sistema Punto de Venta Escritorio" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 7rem 1.5rem 5rem;
    overflow: hidden;
  }

  /* --- Ambient grid (cuadrícula) --- */
  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 45%, transparent 90%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 45%, transparent 90%);
    animation: grid-scroll 12s linear infinite;
    will-change: background-position;
  }

  @keyframes grid-scroll {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 40px 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__grid {
      animation: none;
    }
  }

  /* --- Ambient icon pattern (ticket / scanner / package), estilo doodle --- */
  .hero__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.15);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 45%, transparent 90%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 5%, transparent 90%);
  }

  html[data-theme='light'] .hero__pattern {
    color: rgba(24, 24, 27, 0.2);
  }

  .hero__pattern-svg {
    position: absolute;
    top: -180px;
    left: -180px;
    width: calc(100% + 360px);
    height: calc(100% + 360px);
    animation: pattern-scroll 54s linear infinite;
    will-change: transform;
  }

  @keyframes pattern-scroll {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(180px, 180px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pattern-svg {
      animation: none;
    }
  }

  /* --- Ambient glow --- */
  .hero__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 350px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(63, 63, 70, 0.2), rgba(24, 24, 27, 0.1), transparent);
    filter: blur(120px);
  }

  .hero__inner {
    max-width: 72rem; /* 1152px */
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    max-width: 56rem;
    margin: 0 auto;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--text);
  }

  .hero__lead {
    max-width: 32rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__btn[hidden] {
    display: none !important;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 7px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 150ms ease, border-color 150ms ease,
      color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .hero__btn:active {
    transform: scale(0.98);
  }

  .hero__btn__icon {
    width: 1rem;
    height: 1rem;
  }

  .hero__btn--primary {
    background: #ffffff;
    color: var(--bg);
    box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.1), 0 10px 10px -5px rgba(255, 255, 255, 0.04);
  }
  .hero__btn--primary:hover {
    background: #e4e4e7;
    box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.2), 0 10px 10px -5px rgba(255, 255, 255, 0.04);
  }

  .hero__btn--secondary {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .hero__btn--secondary:hover {
    background: rgba(39, 39, 42, 0.8);
    border-color: var(--hover-border);
    color: var(--text);
  }
  .hero__btn--secondary svg {
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .hero__btn--secondary:hover svg {
    color: var(--text);
  }

  /* En modo claro el botón primario invierte para mantener contraste */
  html[data-theme='light'] .hero__btn--primary {
    background: var(--text);
    color: #ffffff;
    box-shadow: 0 20px 25px -5px rgba(24, 24, 27, 0.2), 0 10px 10px -5px rgba(24, 24, 27, 0.1);
  }
  html[data-theme='light'] .hero__btn--primary:hover {
    background: #27272a;
    box-shadow: 0 20px 25px -5px rgba(24, 24, 27, 0.35), 0 10px 10px -5px rgba(24, 24, 27, 0.1);
  }

  /* ---------- Mockup ---------- */
  .hero__mockup {
    position: relative;
    max-width: 64rem;
    margin: 3.5rem auto 0;
  }

  @media (min-width: 640px) {
    .hero {
      padding-top: 8rem;
    }
    .hero__inner {
      padding: 0 1.5rem;
    }
  }

</style>
