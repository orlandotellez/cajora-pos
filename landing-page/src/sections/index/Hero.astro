---
---

<section class="hero" id="top">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 class="hero__title">
      Tu punto de venta, tus datos, tu negocio
    </h1>

    <p class="hero__lead">
      Vendé, controlá tu inventario y crecé con una herramienta que funciona para vos.
      Disponible gratis en tu servidor o en la nube.
    </p>

    <div class="hero__ctas">
      <a href={import.meta.env.BASE_URL + 'descargar'} class="btn-primary hero__btn-primary">Descargar gratis</a>
      <a href="http://localhost:1420?demo=1" class="btn-secondary hero__btn-secondary" target="_blank" rel="noopener">Ver demo en vivo</a>
    </div>

    <div class="hero__mockup" aria-label="Vista previa del sistema">
      <div class="mockup-frame">
        <div class="mockup-screen">
          <img
            src={import.meta.env.BASE_URL + '1.webp'}
            alt="Vista previa del sistema CajoraPOS"
            class="mockup__img"
            width="1755"
            height="896"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 9rem 0 5rem;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    width: 600px;
    height: 600px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--glow);
    z-index: -1;
  }

  .hero__inner {
    text-align: center;
  }

  .hero__badge {
    display: inline-block;
    padding: 0.25rem 0.875rem;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .hero__lead {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 42rem;
    margin: 0 auto 2.5rem;
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 4rem;
  }

  .hero__btn-primary,
  .hero__btn-secondary {
    width: 100%;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    max-width: 280px;
  }

  .hero__mockup {
    position: relative;
    max-width: 64rem;
    margin: 0 auto;
  }

  .mockup-frame {
    padding: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: background-color 250ms ease, border-color 250ms ease;
  }

  .mockup-screen {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .mockup__img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 640px) {
    .hero__ctas {
      flex-direction: row;
    }

    .hero__btn-primary,
    .hero__btn-secondary {
      width: auto;
    }
  }
</style>
