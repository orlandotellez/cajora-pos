---
---

<!-- Zona de peligro -->
<section class="profile__danger" aria-label="Zona de peligro">
  <h2 class="profile__danger-title">Zona de peligro</h2>

  <div class="profile__danger-row" data-danger-cancel hidden>
    <div>
      <p class="profile__danger-name">Cancelar suscripción</p>
      <p class="profile__danger-desc">
        Se cancela al final del período ya pagado. Seguís con acceso hasta esa fecha.
      </p>
    </div>
    <button type="button" class="profile__danger-btn" data-profile-cancel>
      Cancelar suscripción
    </button>
  </div>

  <div class="profile__danger-row" data-danger-scheduled hidden>
    <div>
      <p class="profile__danger-name">Cancelación programada</p>
      <p class="profile__danger-desc" data-danger-scheduled-text>—</p>
    </div>
    <button type="button" class="btn-secondary profile__submit" data-profile-reactivate>
      Reactivar suscripción
    </button>
  </div>

  <div class="profile__danger-row">
    <div>
      <p class="profile__danger-name">Cerrar sesión</p>
      <p class="profile__danger-desc">Cierra tu sesión en este dispositivo.</p>
    </div>
    <button type="button" class="profile__danger-btn" data-logout>
      Cerrar sesión
    </button>
  </div>
</section>

<!-- Confirmación de cierre de sesión -->
<dialog class="profile__confirm" data-logout-dialog>
  <div class="profile__confirm-box">
    <h3 class="profile__confirm-title">¿Cerrar sesión?</h3>
    <p class="profile__confirm-text">
      Vas a cerrar tu sesión en este dispositivo. Vas a necesitar iniciar sesión de nuevo
      para volver a tu tienda.
    </p>
    <div class="profile__confirm-actions">
      <button type="button" class="btn-secondary profile__confirm-btn" data-logout-cancel>
        Cancelar
      </button>
      <button type="button" class="profile__danger-btn profile__confirm-btn" data-logout-confirm>
        Cerrar sesión
      </button>
    </div>
  </div>
</dialog>

<!-- Confirmación de cancelación de suscripción -->
<dialog class="profile__confirm" data-cancel-dialog>
  <div class="profile__confirm-box">
    <h3 class="profile__confirm-title">¿Cancelar tu suscripción?</h3>
    <p class="profile__confirm-text">
      Se cancelará al final del período ya pagado y seguirás con acceso hasta esa fecha.
      No perderás tu tienda ni tus datos.
    </p>
    <div class="profile__confirm-actions">
      <button type="button" class="btn-secondary profile__confirm-btn" data-cancel-dismiss>
        Seguir con mi plan
      </button>
      <button type="button" class="profile__danger-btn profile__confirm-btn" data-cancel-confirm>
        Cancelar suscripción
      </button>
    </div>
  </div>
</dialog>

<style>
  .profile__danger {
    margin-top: 2.5rem;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 5px;
    background: rgba(239, 68, 68, 0.04);
    padding: 1.5rem;
  }

  .profile__danger-title {
    font-size: 1rem;
    color: #ef4444;
    margin-bottom: 0.5rem;
  }

  .profile__danger-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .profile__danger-row:first-of-type {
    border-top: 0;
  }

  .profile__danger-name {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .profile__danger-desc {
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin-top: 0.25rem;
  }

  .profile__danger-btn {
    flex-shrink: 0;
    background: transparent;
    border: 1px solid rgba(239, 68, 68, 0.5);
    border-radius: var(--radius);
    color: #ef4444;
    padding: 0.6rem 1rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .profile__danger-btn:hover {
    background: rgba(239, 68, 68, 0.1);
  }

  .profile__submit {
    padding: 0.75rem 1.5rem;
    align-self: flex-start;
  }

  .profile__confirm {
    /* El reset global `* { margin: 0 }` del Layout pisa el `margin: auto` que
       el navegador usa para centrar el dialog — hay que restaurarlo. */
    margin: auto;
    border: none;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    padding: 0;
    width: min(24rem, calc(100vw - 2rem));
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  }

  .profile__confirm::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .profile__confirm[open] {
    animation: profile__confirm-in 180ms ease;
  }

  @keyframes profile__confirm-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .profile__confirm-box {
    padding: 1.5rem;
  }

  .profile__confirm-title {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .profile__confirm-text {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .profile__confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .profile__confirm-btn {
    padding: 0.6rem 1.25rem;
    font-size: 0.875rem;
    border-radius: var(--radius);
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .profile__confirm-actions {
      flex-direction: column-reverse;
    }

    .profile__confirm-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .profile__danger-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .profile__danger-btn,
    .profile__submit {
      width: 100%;
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
