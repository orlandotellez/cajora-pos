---
---

<!-- Modal: visualización de planes existentes -->
<div class="plans-modal" data-plans-modal hidden>
  <div class="plans-modal__backdrop" data-plans-close></div>
  <div class="plans-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="plans-title">
    <div class="plans-modal__head">
      <h2 id="plans-title" class="plans-modal__title">Planes disponibles</h2>
      <button type="button" class="plans-modal__close" data-plans-close aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
    <p class="plans-modal__subtitle">Elegí la opción que mejor se adapte a tu negocio.</p>

    <div class="plans-modal__grid">
      <!-- Self-hosted -->
      <article class="plans-modal__plan">
        <div class="plans-modal__plan-head">
          <h3 class="plans-modal__plan-title">Gratis · Self-hosted</h3>
          <div class="plans-modal__plan-price">
            <span class="plans-modal__amount">$0</span>
            <span class="plans-modal__period">/siempre</span>
          </div>
        </div>
        <ul class="plans-modal__list">
          <li><span class="plans-modal__check">✓</span> Instalación en servidor propio</li>
          <li><span class="plans-modal__check">✓</span> Productos y ventas ilimitadas</li>
          <li><span class="plans-modal__check">✓</span> Datos 100% privados</li>
          <li><span class="plans-modal__check">✓</span> Comunidad de soporte</li>
        </ul>
      </article>

      <!-- Cloud -->
      <article class="plans-modal__plan plans-modal__plan--featured">
        <span class="plans-modal__tag">Recomendado</span>
        <div class="plans-modal__plan-head">
          <h3 class="plans-modal__plan-title">Suscripción · Cloud</h3>
          <div class="plans-modal__plan-price">
            <span class="plans-modal__amount">$15.99</span>
            <span class="plans-modal__period">/mes</span>
          </div>
        </div>
        <ul class="plans-modal__list">
          <li><span class="plans-modal__check">✓</span> Respaldos automáticos diarios</li>
          <li><span class="plans-modal__check">✓</span> Soporte técnico prioritario</li>
          <li><span class="plans-modal__check">✓</span> Configuración asistida</li>
          <li><span class="plans-modal__check">✓</span> Acceso remoto desde cualquier lugar</li>
          <li><span class="plans-modal__check">✓</span> Actualizaciones automáticas</li>
        </ul>
        <button type="button" class="btn-primary plans-modal__cta" data-plans-close data-plans-select>
          Continuar con este plan
        </button>
      </article>
    </div>
  </div>
</div>

<style>
  /* -------- Modal de planes -------- */

  .plans-modal[hidden] {
    display: none;
  }

  .plans-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .plans-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  .plans-modal__dialog {
    position: relative;
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .plans-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .plans-modal__title {
    font-size: 1.375rem;
    margin: 0;
  }

  .plans-modal__close {
    background: none;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    transition: color 150ms ease;
  }

  .plans-modal__close:hover {
    color: var(--text);
  }

  .plans-modal__subtitle {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0.5rem 0 1.5rem;
  }

  .plans-modal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .plans-modal__plan {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .plans-modal__plan--featured {
    border-color: var(--text);
  }

  .plans-modal__tag {
    position: absolute;
    top: -0.75rem;
    right: 1.5rem;
    padding: 0.25rem 0.75rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.625rem;
    font-weight: 700;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .plans-modal__plan-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.375rem;
  }

  .plans-modal__plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-top: 0.375rem;
  }

  .plans-modal__amount {
    font-size: 2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .plans-modal__period {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .plans-modal__list {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .plans-modal__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .plans-modal__plan--featured .plans-modal__list li {
    color: var(--text);
  }

  .plans-modal__check {
    color: var(--green);
    font-weight: 700;
    flex-shrink: 0;
  }

  .plans-modal__cta {
    width: 100%;
    padding: 0.75rem 1.25rem;
    text-align: center;
  }

  @media (min-width: 900px) {
    .plans-modal__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 400px) {
    .plans-modal__plan {
      padding: 1.25rem;
    }
  }
</style>