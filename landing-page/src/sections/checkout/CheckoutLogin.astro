---
---

<div data-step-panel="1" data-login-panel hidden>
  <h1 class="checkout__title">Iniciá sesión</h1>
  <p class="checkout__lead">
    Ingresá con la cuenta de tu tienda para continuar con el pago.
  </p>

  <form class="checkout__form-fields" data-login-form novalidate>
    <label class="checkout__field">
      <span>Email</span>
      <input type="email" name="email" placeholder="tucorreo@ejemplo.com" required />
    </label>

    <label class="checkout__field">
      <span>Contraseña</span>
      <span class="field-password">
        <input type="password" name="password" placeholder="Tu contraseña" required minlength="8" />
        <button type="button" class="field-password__toggle" data-toggle-password aria-label="Mostrar contraseña">
          <svg class="field-password__eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <svg class="field-password__eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/>
            <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/>
            <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/>
            <path d="m2 2 20 20"/>
          </svg>
        </button>
      </span>
    </label>

    <p class="checkout__error" data-login-error role="alert" hidden></p>

    <button type="submit" class="btn-primary checkout__submit" data-login-submit disabled>
      Iniciar sesión y continuar
    </button>
  </form>

  <p class="checkout__switch">
    ¿No tenés cuenta?
    <button type="button" class="checkout__link" data-toggle="register">Crear cuenta</button>
  </p>
</div>

<style>
  .checkout__title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .checkout__lead {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.75rem;
  }

  .checkout__form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checkout__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .checkout__field input {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    transition: border-color 150ms ease;
  }

  .checkout__field input:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  .field-password {
    position: relative;
    display: block;
  }

  .field-password input {
    width: 100%;
    padding-right: 2.75rem;
  }

  .field-password__toggle {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color 150ms ease;
  }

  .field-password__toggle:hover {
    color: var(--text);
  }

  .field-password__eye-off {
    display: none;
  }

  .field-password__toggle.is-visible .field-password__eye {
    display: none;
  }

  .field-password__toggle.is-visible .field-password__eye-off {
    display: block;
  }

  .checkout__error {
    color: #ef4444;
    font-size: 0.8125rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
  }

  .checkout__submit {
    padding: 0.75rem 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .checkout__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .checkout__switch {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    
  }

  .checkout__link {
    background: none;
    border: 0;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .checkout__link:hover {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .checkout__title {
      font-size: 1.375rem;
    }
  }
</style>