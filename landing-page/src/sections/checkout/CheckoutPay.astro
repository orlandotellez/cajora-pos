---
---

<div data-step-panel="3" hidden>
  <h1 class="checkout__title">Activá tu suscripción</h1>
  <p class="checkout__lead">
    Elegí cómo pagar <strong>$15.99/mes</strong>. Podés cancelar cuando quieras.
    <button type="button" class="checkout__link checkout__link-inline" data-plans-open>Ver planes</button>
  </p>

  <div class="checkout__success" data-pay-success hidden>
    ✓ Tienda <strong data-success-store></strong> creada — completá el pago abajo.
  </div>

  <div id="paypal-buttons" data-pay-buttons></div>
  <div class="pay__loading" data-pay-loading role="status" hidden>
    <span class="pay__spinner" aria-hidden="true"></span>
    <span>Cargando método de pago...</span>
  </div>
  <p class="pay__error" data-pay-error role="alert" hidden></p>

  <div class="pay__skip">
    <a href="#" class="checkout__link" data-go-pos>
      Lo pago después — mi trial sigue activo
    </a>
  </div>
  <div class="pay__switch">
    <button type="button" class="checkout__link" data-reset>Cambiar de cuenta</button>
  </div>
</div>

<style>
  .checkout__title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .checkout__lead {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.75rem;
  }

  .checkout__success {
    color: var(--green);
    font-size: 0.875rem;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    margin-bottom: 1.25rem;
  }

  .pay__error {
    color: #ef4444;
    font-size: 0.8125rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    margin-top: 1rem;
  }

  /* Confina los iframes de PayPal en un stacking context propio: sin esto,
     al scrollear quedan por encima del header fijo. */
  #paypal-buttons {
    position: relative;
    z-index: 0;
  }

  :global(.pay__sep) {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin: 0.75rem 0;
  }

  .pay__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 2rem 0;
    margin-top: 0.75rem;
  }

  .pay__loading[hidden] {
    display: none;
  }

  .pay__spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border);
    border-top-color: var(--text);
    border-radius: 50%;
    animation: pay-spin 700ms linear infinite;
    flex-shrink: 0;
  }

  @keyframes pay-spin {
    to {
      transform: rotate(360deg);
    }
  }

  :global(.checkout__submit) {
    padding: 0.75rem 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  :global(.checkout__submit:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pay__skip {
    text-align: center;
    margin-top: 1.5rem;
  }

  .pay__switch {
    text-align: center;
    margin-top: 0.5rem;
  }

  .checkout__link {
    background: none;
    border: 0;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .checkout__link:hover {
    color: var(--text-muted);
  }

  .checkout__link-inline {
    margin-left: 0.375rem;
  }

  @media (max-width: 640px) {
    .checkout__title {
      font-size: 1.375rem;
    }
  }
</style>