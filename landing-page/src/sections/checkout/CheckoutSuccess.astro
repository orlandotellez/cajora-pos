<!-- Paso 4: listo -->
<div data-step-panel="4" hidden>
  <div class="success">
    <div class="success__badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </div>

    <h1 class="success__title">¡Suscripción activa!</h1>
    <p class="success__lead">
      Tu tienda ya está en modo Cloud. Entrá y empezá a vender.
    </p>

    <div class="success__actions">
      <a href="#" class="btn-primary success__primary" data-go-pos>Ir a mi tienda</a>
      <a href={import.meta.env.BASE_URL + 'perfil'} class="success__secondary">Ver mi perfil</a>
    </div>
  </div>
</div>

<style>
  .success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem 0 0.5rem;
  }

  /* Check grande en un círculo verde con halo: es la señal principal de que el pago se
     acreditó, así que se lleva el foco visual de todo el panel. */
  .success__badge {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 1.5rem;
    border-radius: 50%;
    color: var(--green);
    background: rgba(16, 185, 129, 0.12);
    border: 2px solid rgba(16, 185, 129, 0.35);
    box-shadow:
      0 0 0 8px rgba(16, 185, 129, 0.06),
      0 12px 40px -12px rgba(16, 185, 129, 0.45);
    animation: success-pop 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .success__badge svg {
    width: 48px;
    height: 48px;
    stroke-width: 2.5;
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
    animation: success-check 420ms 140ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes success-pop {
    from {
      opacity: 0;
      transform: scale(0.72);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes success-check {
    to {
      stroke-dashoffset: 0;
    }
  }

  .success__title {
    font-size: 1.625rem;
    line-height: 1.2;
    margin-bottom: 0.625rem;
  }

  .success__lead {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 26rem;
    margin-bottom: 2rem;
  }

  .success__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 21rem;
  }

  .success__primary {
    width: 100%;
    padding: 0.875rem 1.25rem;
    font-weight: 700;
  }

  .success__secondary {
    width: 100%;
    padding: 0.8125rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .success__secondary:hover {
    border-color: var(--text-muted);
    background: var(--border-glass-soft);
  }

  .success__secondary:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  /* Quien pidió menos movimiento no debería recibir la animación de entrada. */
  @media (prefers-reduced-motion: reduce) {
    .success__badge,
    .success__badge svg {
      animation: none;
    }

    .success__badge svg {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 640px) {
    .success__badge {
      width: 84px;
      height: 84px;
      margin-bottom: 1.25rem;
    }

    .success__badge svg {
      width: 42px;
      height: 42px;
    }

    .success__title {
      font-size: 1.375rem;
    }
  }
</style>
