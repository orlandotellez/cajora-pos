---
---

<!-- Paso 2: confirmar correo -->
<div data-step-panel="2" hidden>
  <h1 class="checkout__title">Confirmá tu correo</h1>
  <p class="checkout__lead">
    Te enviamos un código de verificación a <strong data-verify-email></strong>.
    Ingresalo abajo para continuar con el pago.
  </p>

  <div class="checkout__success" data-verify-success hidden>
    ✓ Correo verificado — ya podés continuar con el pago.
  </div>

  <form class="checkout__form-fields" data-verify-form novalidate>
    <label class="checkout__field">
      <span>Código de verificación</span>
      <input
        type="text"
        name="code"
        placeholder="Ej: 4K7M2P"
        required
        minlength="6"
        maxlength="6"
        autocomplete="one-time-code"
        inputmode="text"
        data-verify-input
      />
    </label>

    <p class="checkout__error" data-verify-error role="alert" hidden></p>

    <button type="submit" class="btn-primary checkout__submit" data-verify-submit disabled>
      Verificar correo
    </button>
    <p class="checkout__hint" data-verify-hint>Ingresá el código de 6 caracteres que recibiste.</p>
  </form>

  <div class="checkout__switch">
    ¿No te llegó el correo?
    <button type="button" class="checkout__link" data-resend-code>Reenviar código</button>
  </div>

  <div class="pay__switch">
    <button type="button" class="checkout__link" data-verify-change-account>Cambiar de cuenta</button>
  </div>
</div>

<style>
  .checkout__title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .checkout__lead {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.75rem;
  }

  .checkout__form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checkout__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .checkout__field input {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    transition: border-color 150ms ease;
  }

  .checkout__field input:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  .checkout__error {
    color: #ef4444;
    font-size: 0.8125rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
  }

  .checkout__success {
    color: var(--green);
    font-size: 0.875rem;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    margin-bottom: 1.25rem;
  }

  .checkout__submit {
    padding: 0.75rem 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .checkout__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .checkout__hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: -0.25rem;
  }

  .checkout__switch {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    
  }

  .checkout__link {
    background: none;
    border: 0;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .checkout__link:hover {
    color: var(--text-muted);
  }

  .pay__switch {
    text-align: center;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .checkout__title {
      font-size: 1.375rem;
    }
  }
</style>