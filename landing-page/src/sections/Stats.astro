---
const stats = [
  { title: 'Ventas rápidas', subtitle: 'Escaneo instantáneo' },
  { title: 'Stock real', subtitle: 'Control automático' },
  { title: 'Multi-usuario', subtitle: 'Roles y permisos' },
  { title: '100% Offline', subtitle: 'Sin cortes de servicio' },
];
---

<section class="stats" aria-label="Características rápidas">
  <div class="container stats__grid">
    {stats.map((stat) => (
      <div class="stats__item">
        <div class="stats__title">{stat.title}</div>
        <div class="stats__subtitle">{stat.subtitle}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    padding: 3rem 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background-color 250ms ease, border-color 250ms ease;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stats__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .stats__subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
