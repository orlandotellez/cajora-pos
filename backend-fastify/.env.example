# Entorno 
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/pos_system_db?schema=public

# Redis (opcional) 
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth JWT 
JWT_SECRET=cambiar_por_un_secreto_de_32+_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_de_32+_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Verificación de correo al registrarse. Con `false` la cuenta nace verificada y no se envía
# ningún código: sirve para dar de alta tiendas en desarrollo sin un email real y sin
# RESEND_API_KEY. El proceso NO arranca si se combina con NODE_ENV=production.
EMAIL_VERIFICATION=true

#  Paypal
PAYPAL_ENABLED=false
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook registrado en el dashboard de PayPal (verificación de firma)
PAYPAL_WEBHOOK_ID=
# plan_id del plan de suscripción mensual  creado en el merchant dashboard
PAYPAL_PLAN_ID_MONTHLY=

#  Whop (proveedor primario del cobro de la suscripción Cloud)
WHOP_ENABLED=false
# Entorno de la API de Whop: false = producción (default), true = sandbox.
# OJO: el embed de Whop Elements NO soporta sandbox, así que en sandbox se paga por el
# checkout hospedado de sandbox.whop.com. Sin esta variable, el cliente va a producción.
WHOP_SANDBOX=false
WHOP_API_KEY=
# Secreto de firma del webhook (Standard Webhooks, formato ws_...)
WHOP_WEBHOOK_SECRET=
# plan_... del plan mensual creado en el dashboard de Whop
WHOP_PLAN_ID_MONTHLY=
# Secreto para firmar las referencias de checkout (anti-suplantación de tienda).
# Si queda vacío, el código usa JWT_SECRET como respaldo.
WHOP_CHECKOUT_REF_SECRET=
# "cloud" aplica licenseGuard a features premium; "self_hosted" corre sin gateo
APP_MODE=self_hosted

#  Reconciliación de suscripciones vs PayPal (alinea la DB con la verdad de PayPal)
RECONCILE_INTERVAL_MS=3600000
RECONCILE_ON_START=true

RESEND_API_KEY=
EMAIL_FROM="CajoraPOS <no-reply@cajorapos.com>"
